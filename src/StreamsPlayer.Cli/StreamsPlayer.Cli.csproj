<Project Sdk="Microsoft.NET.Sdk">

  <!-- SP-0275 (APP-COMMANDS rule 9): the console companion of the player's command line. A console-subsystem executable, so
       a caller that pipes can read its standard output and its exit code. It references the platform-neutral core and
       nothing else: no desktop framework, no application project. Its whole behaviour is AppCommandConsole in the core;
       the one file here is the entry point that hands it the process's own streams. The player's project builds it and
       publishes it into its own folder, so it ships in the portable folder, the installer and the Store package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StreamsPlayerCli</AssemblyName>
    <RootNamespace>StreamsPlayer.Cli</RootNamespace>
    <AssemblyTitle>StreamsPlayer command line</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon Condition="Exists('..\..\assets\streamsplayer.ico')">..\..\assets\streamsplayer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamsPlayer.Core\StreamsPlayer.Core.csproj" />
  </ItemGroup>

</Project>
