<Window x:Class="StreamsPlayer.App.CompactPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamsPlayer.App"
        FlowDirection="{DynamicResource UiFlowDirection}"
        Title="{DynamicResource ProductName}"
        Width="600" Height="80"
        SizeToContent="Manual" WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="Manual"
        Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
        Foreground="{DynamicResource TextBrush}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        LocationChanged="Window_LocationChanged">
    <!-- SP-0080 / SP-0102: a captionless strip. The top line names the station and its tags; the line
         below carries the icon, the playback controls and the window's own buttons, since there is no
         system caption to hold them. Any spot outside a control drags the window.
         ResizeMode is CanMinimize rather than NoResize: without the minimize box the taskbar button
         cannot minimize or restore the window, and the panel has its own minimize button. -->
    <Grid>
    <!-- SP-0110 (WAVE-PARTICLES): an audio player backdrop - ambient, so a power policy freezes it later
         than the catalog's decorative one. It takes no input, so a drag from any empty spot still moves
         the window. The wash is the panel's own themed background. -->
    <local:WaveParticlesBackdrop x:Name="Backdrop" Intent="Ambient" Intensity="0.45"
                                 WashBrush="{DynamicResource SurfaceBrush}" />
    <Grid Margin="10,6,6,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: station title + tags, trimmed as one line. The tooltip carries the now-playing
             line (with the track, when the stream reports one) and the status line. -->
        <TextBlock x:Name="HeaderText" Grid.Row="0" Margin="2,0,4,2"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center">
            <Run x:Name="StationTitleRun" FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" /><Run x:Name="TagsSeparatorRun" Text="    " /><Run x:Name="TagsRun" FontSize="11"
                 Foreground="{DynamicResource MutedBrush}" />
        </TextBlock>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Station Favicon plate with fallback monogram and animated audio indicator -->
            <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border Width="38" Height="38" Background="{DynamicResource FaviconPlateBrush}" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <!-- Fallback monogram plate. Out of theme (APP-STYLE 5): the plate is the channel's
                             identity colour (MonogramPalette, assigned from code; the value here is only the
                             start), with its own white ink and its own dark strip for the country. -->
                        <Border x:Name="MonogramPlate" CornerRadius="6" Background="#FF336699" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="MonogramText" Grid.Row="0" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="CountryCodeBadge" Grid.Row="1" Background="#59000000" Visibility="Collapsed">
                                    <TextBlock x:Name="CountryCodeText" Foreground="White" FontSize="8" LineHeight="10"
                                               LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Station Favicon Image -->
                        <Image x:Name="FaviconImage" Width="38" Height="38" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <!-- Playing animation badge. Out of theme (APP-STYLE 5): drawn over the favicon, a
                     picture, so it carries its own disc and white note - the one the main window's
                     cards and tiles use. -->
                <Grid x:Name="PlayingIndicator" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse Fill="#CC2364AA" />
                    <Path Data="{StaticResource Icon.content.audio}" FlowDirection="LeftToRight"
                          Fill="White" Stretch="Uniform" Margin="4" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="CompactNoteRotate" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.8" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
            </Grid>

            <!-- Column 1: playback controls (Volume + Sleep Timer + Prev + Next + Random + Record + Play/Stop) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Slider x:Name="VolumeSlider" Width="70" Minimum="0" Maximum="100" Value="100"
                        TickFrequency="10" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        ValueChanged="VolumeSlider_ValueChanged"
                        ToolTip="{DynamicResource AudioVolumeTip}"
                        AutomationProperties.Name="{DynamicResource AudioVolumeName}" />

                <Button x:Name="SleepTimerButton" Style="{StaticResource SleepTimerGlyphButton}"
                        Margin="6,0,0,0" Click="SleepTimerButton_Click"
                        ToolTip="{DynamicResource SleepTimerTip}"
                        AutomationProperties.Name="{DynamicResource SleepTimer}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SleepTimerContextMenu" />
                    </Button.ContextMenu>
                </Button>

                <Button x:Name="PrevStationButton" Style="{StaticResource PrevGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="PrevStationButton_Click"
                        ToolTip="{DynamicResource PrevStationTip}"
                        AutomationProperties.Name="{DynamicResource PrevStationTip}" />

                <Button x:Name="NextStationButton" Style="{StaticResource NextGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="NextStationButton_Click"
                        ToolTip="{DynamicResource NextStationTip}"
                        AutomationProperties.Name="{DynamicResource NextStationTip}" />

                <Button x:Name="RandomButton" Style="{StaticResource RandomGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="RandomButton_Click"
                        ToolTip="{DynamicResource RandomStationTip}"
                        AutomationProperties.Name="{DynamicResource RandomStation}" />

                <Button x:Name="RecordButton" Style="{StaticResource RecordGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="RecordButton_Click"
                        ToolTip="{DynamicResource RecordTip}"
                        AutomationProperties.Name="{DynamicResource Record}" />

                <Button x:Name="TransportButton" Style="{StaticResource StopGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="TransportButton_Click" IsEnabled="False"
                        ToolTip="{DynamicResource StopAudio}"
                        AutomationProperties.Name="{DynamicResource StopAudio}" />
            </StackPanel>

            <!-- Column 2: window buttons (Always on top + Expand + Minimize + Close) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="TopmostButton" Style="{StaticResource PinOnGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="TopmostButton_Click"
                        ToolTip="{DynamicResource CompactPanelOnTopOn}"
                        AutomationProperties.Name="{DynamicResource CompactPanelOnTopOn}" />

                <Button x:Name="ExpandButton" Style="{StaticResource FullWindowGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="ExpandButton_Click"
                        ToolTip="{DynamicResource ExpandFromPanelTip}"
                        AutomationProperties.Name="{DynamicResource ExpandFromPanelName}" />

                <Button x:Name="MinimizeButton" Style="{StaticResource MinimizeGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="MinimizeButton_Click"
                        ToolTip="{DynamicResource CompactPanelMinimizeTip}"
                        AutomationProperties.Name="{DynamicResource CompactPanelMinimizeTip}" />

                <Button x:Name="CloseButton" Style="{StaticResource CloseGlyphOnlyButton}"
                        Margin="4,0,0,0" Padding="9,7" Click="CloseButton_Click"
                        ToolTip="{DynamicResource CompactPanelCloseTip}"
                        AutomationProperties.Name="{DynamicResource CompactPanelCloseTip}" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</Window>
