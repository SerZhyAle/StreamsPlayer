<Window x:Class="StreamsPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource SettingsWindowTitle}" Width="720" Height="640"
        MinWidth="640" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Monochrome tab-strip icon: an ICON-SET glyph (Glyphs.xaml), filled, at the 20 tier, never
             mirrored (SP-0113). -->
        <Style x:Key="TabIcon" TargetType="Path">
            <!-- The 24 grid drawn at the 20 tier: scaled as a whole, so every tab glyph keeps its own margin
                 (ICON-RENDER 5) instead of being stretched to its ink. -->
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.8333" ScaleY="0.8333" />
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="SettingsContent" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <TabControl x:Name="SettingsTabControl" TabStripPlacement="Left" Background="Transparent"
                        BorderThickness="0" Padding="14">

                <!-- 1. General -->
                <TabItem AutomationProperties.Name="{DynamicResource SettingsGeneral}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.app.settings}" />
                            <TextBlock Text="{DynamicResource SettingsGeneral}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource SettingsGeneralDesc}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Language -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.pending.app.language}" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource Language}"
                                      SelectionChanged="LanguageBox_SelectionChanged" />
                            <TextBlock Text="{DynamicResource MachineTranslationNotice}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" />

                            <!-- Colour theme -->
                            <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="SemiBold" />
                            <ComboBox x:Name="ThemeBox" Margin="0,5,0,4" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource ThemeLabel}"
                                      SelectionChanged="ThemeBox_SelectionChanged" />
                            <TextBlock Text="{DynamicResource ThemeHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" />

                            <!-- Stream tile size -->
                            <TextBlock Text="{DynamicResource StreamTileSizeLabel}" FontWeight="SemiBold" />
                            <ComboBox x:Name="TileSizeBox" Margin="0,5,0,4" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource StreamTileSizeLabel}"
                                      SelectionChanged="TileSizeBox_SelectionChanged" />
                            <TextBlock Text="{DynamicResource TileSizeHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" />

                            <!-- Animated backdrop -->
                            <CheckBox x:Name="AnimatedBackdropCheckBox" Click="AnimatedBackdropCheckBox_Click"
                                      ToolTip="{DynamicResource AnimatedBackdropTip}"
                                      AutomationProperties.Name="{DynamicResource AnimatedBackdrop}">
                                <TextBlock Text="{DynamicResource AnimatedBackdrop}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{DynamicResource AnimatedBackdropHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="22,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 2. Library -->
                <TabItem AutomationProperties.Name="{DynamicResource SettingsLibrary}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.view.grid}" />
                            <TextBlock Text="{DynamicResource SettingsLibrary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource SettingsLibraryDesc}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Library Settings -->
                            <CheckBox x:Name="HideAdultContentCheckBox" Click="HideAdultContentCheckBox_Click"
                                      Content="{DynamicResource HideAdultContent}"
                                      ToolTip="{DynamicResource HideAdultContentTip}"
                                      AutomationProperties.Name="{DynamicResource HideAdultContent}" />
                            <TextBlock Text="{DynamicResource HideAdultContentHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="22,4,0,12" />

                            <CheckBox x:Name="UpdatePreviewsCheckBox" Click="UpdatePreviewsCheckBox_Click"
                                      Content="{DynamicResource UpdateStreamPreviews}"
                                      ToolTip="{DynamicResource UpdateStreamPreviewsTip}"
                                      AutomationProperties.Name="{DynamicResource UpdateStreamPreviews}" />
                            <TextBlock Text="{DynamicResource UpdateStreamPreviewsHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="22,4,0,14" />

                            <!-- Stream catalog -->
                            <Separator Margin="0,0,0,12" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{DynamicResource StreamCatalogSettings}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource StreamCatalogSettingsHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button x:Name="ImportCatalogFromFileButton" Style="{StaticResource ImportGlyphButton}"
                                    HorizontalAlignment="Left"
                                    Content="{DynamicResource ImportCatalogFromFile}" Click="ImportCatalogFromFile_Click"
                                    ToolTip="{DynamicResource ImportCatalogFromFileTip}"
                                    AutomationProperties.Name="{DynamicResource ImportCatalogFromFile}" />

                            <!-- Bundled snapshot -->
                            <TextBlock Text="{DynamicResource CatalogSnapshotSettingsHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,12,0,8" />
                            <Button x:Name="ApplyCatalogSnapshotButton" Style="{StaticResource ImportGlyphButton}"
                                    HorizontalAlignment="Left" Content="{DynamicResource CatalogSnapshotSettings}"
                                    Click="ApplyCatalogSnapshot_Click" ToolTip="{DynamicResource CatalogSnapshotSettingsTip}"
                                    AutomationProperties.Name="{DynamicResource CatalogSnapshotSettings}" />

                            <!-- Destructive cleanup -->
                            <TextBlock Text="{DynamicResource DeleteDownloadedHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,12,0,8" />
                            <WrapPanel>
                                <Button x:Name="DeleteDownloadedButton" Style="{StaticResource DeleteGlyphButton}"
                                        Content="{DynamicResource DeleteDownloaded}"
                                        Click="DeleteDownloaded_Click" ToolTip="{DynamicResource DeleteDownloadedTip}"
                                        AutomationProperties.Name="{DynamicResource DeleteDownloaded}" Margin="0,0,10,0" />
                                <Button x:Name="DeleteImportedCatalogButton" Style="{StaticResource DeleteGlyphButton}"
                                        Content="{DynamicResource DeleteImportedCatalog}"
                                        Click="DeleteImportedCatalog_Click" ToolTip="{DynamicResource DeleteImportedCatalogTip}"
                                        AutomationProperties.Name="{DynamicResource DeleteImportedCatalog}" />
                            </WrapPanel>

                            <!-- Playlists (M3U) -->
                            <Separator Margin="0,16,0,12" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{DynamicResource PlaylistPortability}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource PlaylistPortabilityHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button x:Name="ImportFromFileButton" Style="{StaticResource ImportGlyphButton}"
                                        Content="{DynamicResource ImportFromFile}" Click="ImportFromFile_Click"
                                        ToolTip="{DynamicResource ImportListTip}" Margin="0,0,8,0" />
                                <Button x:Name="ImportFromUrlButton" Style="{StaticResource ImportGlyphButton}"
                                        Content="{DynamicResource ImportFromUrl}" Click="ImportFromUrl_Click"
                                        ToolTip="{DynamicResource ImportListTip}" Margin="0,0,8,0" />
                                <Button x:Name="ExportAllButton" Style="{StaticResource ExportGlyphButton}"
                                        Content="{DynamicResource ExportAll}" Click="ExportAll_Click"
                                        ToolTip="{DynamicResource ExportListTip}" Margin="0,0,8,0" />
                                <Button x:Name="ExportPinnedButton" Style="{StaticResource ExportGlyphButton}"
                                        Content="{DynamicResource ExportPinned}" Click="ExportPinned_Click"
                                        ToolTip="{DynamicResource ExportListTip}" />
                            </WrapPanel>
                            <Button x:Name="ManageHiddenButton" Style="{StaticResource HiddenGlyphButton}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Content="{DynamicResource ManageHiddenOpen}" Click="ManageHidden_Click"
                                    ToolTip="{DynamicResource ManageHiddenTip}"
                                    AutomationProperties.Name="{DynamicResource ManageHiddenOpen}" />

                            <!-- TV schedule -->
                            <Separator Margin="0,16,0,12" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{DynamicResource TvScheduleTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource TvScheduleHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBox x:Name="TvScheduleAddressBox" Padding="6,4"
                                     AutomationProperties.Name="{DynamicResource TvScheduleAddressName}"
                                     ToolTip="{DynamicResource TvScheduleAddressName}" />
                            <TextBlock x:Name="TvScheduleStatusText" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="TvScheduleDownloadButton" Style="{StaticResource DownloadGlyphButton}"
                                        Content="{DynamicResource TvScheduleDownload}" Click="TvScheduleDownload_Click"
                                        ToolTip="{DynamicResource TvScheduleDownloadTip}"
                                        AutomationProperties.Name="{DynamicResource TvScheduleDownload}" Margin="0,0,8,0" />
                                <Button x:Name="TvScheduleRemoveButton" Style="{StaticResource DeleteGlyphButton}"
                                        Content="{DynamicResource TvScheduleRemove}" Click="TvScheduleRemove_Click"
                                        ToolTip="{DynamicResource TvScheduleRemoveTip}"
                                        AutomationProperties.Name="{DynamicResource TvScheduleRemove}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 3. Playback -->
                <TabItem AutomationProperties.Name="{DynamicResource SettingsPlayback}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.media.play}" />
                            <TextBlock Text="{DynamicResource SettingsPlayback}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource SettingsPlaybackDesc}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <CheckBox x:Name="KeepAwakeCheckBox" Click="KeepAwakeCheckBox_Click"
                                      ToolTip="{DynamicResource KeepAwakeDuringPlaybackTip}"
                                      AutomationProperties.Name="{DynamicResource KeepAwakeDuringPlayback}">
                                <TextBlock Text="{DynamicResource KeepAwakeDuringPlayback}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{DynamicResource KeepAwakeHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="22,4,0,12" />

                            <CheckBox x:Name="SystemMediaControlsCheckBox" Click="SystemMediaControlsCheckBox_Click"
                                      ToolTip="{DynamicResource SystemMediaControlsTip}"
                                      AutomationProperties.Name="{DynamicResource SystemMediaControls}">
                                <TextBlock Text="{DynamicResource SystemMediaControls}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{DynamicResource SmtcHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="22,4,0,12" />

                            <CheckBox x:Name="ResumePlaybackCheckBox" Click="ResumePlaybackCheckBox_Click"
                                      ToolTip="{DynamicResource ResumePlaybackOnStartupTip}"
                                      AutomationProperties.Name="{DynamicResource ResumePlaybackOnStartup}">
                                <TextBlock Text="{DynamicResource ResumePlaybackOnStartup}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{DynamicResource ResumePlaybackHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="22,4,0,14" />

                            <!-- Video backend and components -->
                            <Separator Margin="0,0,0,12" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{DynamicResource VideoBackendLabel}" FontWeight="SemiBold" />
                            <ComboBox x:Name="VideoBackendBox" Margin="0,5,0,0" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource VideoBackendLabel}"
                                      SelectionChanged="VideoBackendBox_SelectionChanged" />
                            <TextBlock Text="{DynamicResource VideoBackendHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock x:Name="VideoComponentsStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="VideoComponentsInstallButton" Style="{StaticResource DownloadGlyphButton}"
                                        Content="{DynamicResource VideoComponentsInstall}"
                                        Click="VideoComponentsInstall_Click" Margin="0,0,8,0" />
                                <Button x:Name="VideoComponentsRemoveButton" Style="{StaticResource DeleteGlyphButton}"
                                        Content="{DynamicResource VideoComponentsRemove}"
                                        Click="VideoComponentsRemove_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 4. Audio -->
                <TabItem AutomationProperties.Name="{DynamicResource SettingsAudio}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.media.volume}" />
                            <TextBlock Text="{DynamicResource SettingsAudio}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource SettingsAudioDesc}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Audio output device -->
                            <TextBlock Text="{DynamicResource AudioOutputDeviceLabel}" FontWeight="SemiBold" />
                            <ComboBox x:Name="AudioDeviceBox" Margin="0,5,0,4" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource AudioOutputDeviceLabel}"
                                      SelectionChanged="AudioDeviceBox_SelectionChanged" />
                            <TextBlock Text="{DynamicResource AudioOutputDeviceHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" />

                            <!-- Audio channel output -->
                            <TextBlock Text="{DynamicResource AudioChannelModeLabel}" FontWeight="SemiBold" />
                            <ComboBox x:Name="AudioChannelBox" Margin="0,5,0,4" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{DynamicResource AudioChannelModeLabel}"
                                      SelectionChanged="AudioChannelBox_SelectionChanged" />
                            <TextBlock Text="{DynamicResource AudioChannelModeHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 5. Files -->
                <TabItem AutomationProperties.Name="{DynamicResource SettingsFiles}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.pending.action.choose-folder}" />
                            <TextBlock Text="{DynamicResource SettingsFiles}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource SettingsFilesDesc}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <!-- Frames folder -->
                            <TextBlock Text="{DynamicResource FrameFolderLabel}" FontWeight="SemiBold" />
                            <TextBox x:Name="FrameFolderBox" IsReadOnly="True" Margin="0,5,0,0" Padding="7,4"
                                     TextWrapping="NoWrap" AutomationProperties.Name="{DynamicResource FrameFolderLabel}" />
                            <TextBlock Text="{DynamicResource FrameFolderHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,6,0,14">
                                <Button x:Name="FrameFolderBrowseButton" Tag="VideoFrame" Style="{StaticResource ChooseFolderGlyphButton}"
                                        Content="{DynamicResource FrameFolderBrowse}" Click="FrameFolderBrowse_Click" Margin="0,0,8,0" />
                                <Button x:Name="FrameFolderResetButton" Tag="VideoFrame" Style="{StaticResource ResetGlyphButton}"
                                        Content="{DynamicResource FrameFolderReset}" Click="FrameFolderReset_Click" Margin="0,0,8,0" />
                                <Button x:Name="FrameFolderOpenButton" Tag="VideoFrame" Style="{StaticResource OpenFolderGlyphButton}"
                                        Content="{DynamicResource FrameFolderOpen}" Click="FrameFolderOpen_Click"
                                        ToolTip="{DynamicResource LogArchiveOpenFolder}" />
                            </WrapPanel>

                            <!-- Video recordings folder -->
                            <TextBlock Text="{DynamicResource VideoRecordingFolderLabel}" FontWeight="SemiBold" />
                            <TextBox x:Name="VideoRecordingFolderBox" IsReadOnly="True" Margin="0,5,0,0" Padding="7,4"
                                     TextWrapping="NoWrap" AutomationProperties.Name="{DynamicResource VideoRecordingFolderLabel}" />
                            <TextBlock Text="{DynamicResource VideoRecordingFolderHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,6,0,14">
                                <Button x:Name="VideoRecordingFolderBrowseButton" Tag="StreamVideo" Style="{StaticResource ChooseFolderGlyphButton}"
                                        Content="{DynamicResource FrameFolderBrowse}" Click="FrameFolderBrowse_Click" Margin="0,0,8,0" />
                                <Button x:Name="VideoRecordingFolderResetButton" Tag="StreamVideo" Style="{StaticResource ResetGlyphButton}"
                                        Content="{DynamicResource FrameFolderReset}" Click="FrameFolderReset_Click" Margin="0,0,8,0" />
                                <Button x:Name="VideoRecordingFolderOpenButton" Tag="StreamVideo" Style="{StaticResource OpenFolderGlyphButton}"
                                        Content="{DynamicResource FrameFolderOpen}" Click="FrameFolderOpen_Click"
                                        ToolTip="{DynamicResource LogArchiveOpenFolder}" />
                            </WrapPanel>

                            <!-- Radio recordings folder -->
                            <TextBlock Text="{DynamicResource AudioRecordingFolderLabel}" FontWeight="SemiBold" />
                            <TextBox x:Name="AudioRecordingFolderBox" IsReadOnly="True" Margin="0,5,0,0" Padding="7,4"
                                     TextWrapping="NoWrap" AutomationProperties.Name="{DynamicResource AudioRecordingFolderLabel}" />
                            <TextBlock Text="{DynamicResource AudioRecordingFolderHint}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="AudioRecordingFolderBrowseButton" Tag="StreamAudio" Style="{StaticResource ChooseFolderGlyphButton}"
                                        Content="{DynamicResource FrameFolderBrowse}" Click="FrameFolderBrowse_Click" Margin="0,0,8,0" />
                                <Button x:Name="AudioRecordingFolderResetButton" Tag="StreamAudio" Style="{StaticResource ResetGlyphButton}"
                                        Content="{DynamicResource FrameFolderReset}" Click="FrameFolderReset_Click" Margin="0,0,8,0" />
                                <Button x:Name="AudioRecordingFolderOpenButton" Tag="StreamAudio" Style="{StaticResource OpenFolderGlyphButton}"
                                        Content="{DynamicResource FrameFolderOpen}" Click="FrameFolderOpen_Click"
                                        ToolTip="{DynamicResource LogArchiveOpenFolder}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 6. About -->
                <TabItem AutomationProperties.Name="{DynamicResource SettingsAbout}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.app.info}" />
                            <TextBlock Text="{DynamicResource SettingsAbout}" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="{DynamicResource SettingsAboutDesc}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,14" />

                            <TextBlock Text="{DynamicResource ProductName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{DynamicResource MainSubtitle}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Grid Margin="0,8,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource VersionLabel}" FontWeight="SemiBold" Margin="0,0,10,5" />
                                <TextBlock x:Name="VersionText" Grid.Column="1" Margin="0,0,0,5" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource AuthorLabel}" FontWeight="SemiBold" Margin="0,0,10,5" />
                                <TextBlock x:Name="AuthorText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource LicenceLabel}" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1">
                                    <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Licence"
                                               Click="OpenLink_Click" ToolTip="{DynamicResource LicenceTip}"
                                               AutomationProperties.Name="{DynamicResource Licence}">
                                        <Run Text="{DynamicResource Licence}" />
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                            <WrapPanel>
                                <TextBlock Margin="0,0,18,8">
                                    <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Instructions"
                                               Click="OpenLink_Click" ToolTip="{DynamicResource DocumentationTip}"
                                               AutomationProperties.Name="{DynamicResource Documentation}">
                                        <Run Text="{DynamicResource Documentation}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,0,18,8">
                                    <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Source"
                                               Click="OpenLink_Click" ToolTip="{DynamicResource SourceCodeTip}"
                                               AutomationProperties.Name="{DynamicResource SourceCode}">
                                        <Run Text="{DynamicResource SourceCode}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,0,18,8">
                                    <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Website"
                                               Click="OpenLink_Click" ToolTip="{DynamicResource WebsiteTip}"
                                               AutomationProperties.Name="{DynamicResource Website}">
                                        <Run Text="{DynamicResource Website}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,0,18,8">
                                    <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Privacy"
                                               Click="OpenLink_Click" ToolTip="{DynamicResource PrivacyTip}"
                                               AutomationProperties.Name="{DynamicResource Privacy}">
                                        <Run Text="{DynamicResource Privacy}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,0,18,8">
                                    <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Author"
                                               Click="OpenLink_Click" ToolTip="{DynamicResource AuthorPageTip}"
                                               AutomationProperties.Name="{DynamicResource AuthorPage}">
                                        <Run Text="{DynamicResource AuthorPage}" />
                                    </Hyperlink>
                                </TextBlock>
                            </WrapPanel>

                            <!-- Diagnostics -->
                            <Separator Margin="0,8,0,12" Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{DynamicResource DiagnosticsHeading}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Button x:Name="SendLogsButton" HorizontalAlignment="Left" Margin="0,0,0,6"
                                    Content="{DynamicResource SendLogs}" Click="SendLogs_Click"
                                    ToolTip="{DynamicResource SendLogsTip}"
                                    AutomationProperties.Name="{DynamicResource SendLogs}" />
                            <TextBlock Text="{DynamicResource SendLogsHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Bottom bar: VideoComponentsCancelButton (left, for long operation) -->
        <Button x:Name="VideoComponentsCancelButton" Grid.Row="1" HorizontalAlignment="Left" Margin="0,14,0,0"
                Padding="14,6" Visibility="Collapsed"
                Content="{DynamicResource VideoComponentsCancel}" Click="VideoComponentsCancel_Click"
                AutomationProperties.Name="{DynamicResource VideoComponentsCancel}" />
    </Grid>
</Window>
