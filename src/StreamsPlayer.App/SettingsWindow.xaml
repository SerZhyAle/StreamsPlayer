<Window x:Class="StreamsPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamsPlayer.App"
        FlowDirection="{DynamicResource UiFlowDirection}" FontSize="{DynamicResource UiFontSize}"
        Title="{DynamicResource SettingsWindowTitle}" Width="760" Height="640"
        MinWidth="640" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- SP-0191: a nav destination's glyph, drawn in that destination's identity ink (one table:
             ThemeService's NavInk* pairs; ICON-RENDER 0.16 section 11, WINDOWS-UI 6.6). The 24 grid at
             the 20 tier, never mirrored (SP-0113). -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.8333" ScaleY="0.8333" />
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <!-- SP-0191: a value row (WINDOWS-UI 4) - the caption and its muted description in the leading
             column, the editor in the trailing column beside both, aligned to one shared page column.
             The star split with a minimum keeps the side-by-side shape at the narrow window, where the
             editor is allowed to shrink; the trailing column caps inside the reference band. Text
             wraps and the row grows vertically. -->
        <Style x:Key="ValueRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- SP-0211: the pointer hit-target floor, 28 px under a mouse or a pen (APP-SETTINGS 7, ICON-RENDER
             3.5). The painted box or text is smaller than the target a click may land on, so the control is
             given the floor as its minimum height - the drawing stays where it was. Scoped to this window:
             the same controls elsewhere keep the compact size their own surfaces were laid out for. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- SettingsLinkButton (SP-0211) lives in App.xaml: the windows that carry the media-exchange link are not
             all this one, and a style that only this window defined made the others fail to load. -->
        <!-- SP-0191: the settings search box (WINDOWS-UI 2.3/3.5), the catalog search's template with
             this surface's own watermark. -->
        <Style x:Key="SettingsSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="2,5,6,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="220" />
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource SettingsSearchWatermark}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="12" Height="12" Margin="6,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Path Data="{StaticResource Icon.action.search}" Width="24" Height="24" FlowDirection="LeftToRight"
                                          Fill="{DynamicResource MutedBrush}" />
                                </Viewbox>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Margin="0" />
                                <TextBlock x:Name="SearchWatermark" Grid.Column="1" Text="{DynamicResource SettingsSearchWatermark}"
                                           Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center"
                                           Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="SearchWatermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18,10,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- SP-0191: the reference layout - one pane holds a navigation column (product name, the page
             list with identity inks, the version) and a content column whose fixed header carries the
             page title and description beside the pane's commands (search, expand all, collapse all;
             WINDOWS-UI 2.2, 2.3). The pages scroll under the header; switching pages never resizes the
             window. -->
        <Border x:Name="SettingsContent" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="12,14,6,12" MinWidth="170">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource ProductName}" FontWeight="SemiBold" FontSize="{DynamicResource UiFontProduct}"
                               TextWrapping="Wrap" Margin="8,0,8,14" Foreground="{DynamicResource TextBrush}" />
                    <ListBox x:Name="NavList" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NavList_SelectionChanged"
                             AutomationProperties.Name="{DynamicResource SettingsWindowTitle}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisualInset}" />
                                <Setter Property="Padding" Value="1" />
                                <Setter Property="MinHeight" Value="28" />
                                <Setter Property="Margin" Value="2,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="3"
                                                    BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource SettingsGeneral}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.app.settings}" Fill="{DynamicResource NavInkGeneral}" />
                                <TextBlock Text="{DynamicResource SettingsGeneral}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource SettingsLibrary}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.view.grid}" Fill="{DynamicResource NavInkLibrary}" />
                                <TextBlock Text="{DynamicResource SettingsLibrary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource SettingsPlayback}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.media.play}" Fill="{DynamicResource NavInkPlayback}" />
                                <TextBlock Text="{DynamicResource SettingsPlayback}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource SettingsAudio}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.media.volume}" Fill="{DynamicResource NavInkAudio}" />
                                <TextBlock Text="{DynamicResource SettingsAudio}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource SettingsFiles}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.action.choose-folder}" Fill="{DynamicResource NavInkFiles}" />
                                <TextBlock Text="{DynamicResource SettingsFiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource ExchangeTitle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.source.exchange-server}" Fill="{DynamicResource NavInkLibrary}" />
                                <TextBlock Text="{DynamicResource ExchangeTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource BroadcastTitle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.feature.live-broadcast}" Fill="{DynamicResource NavInkPlayback}" />
                                <TextBlock Text="{DynamicResource BroadcastTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{DynamicResource SettingsAbout}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.app.info}" Fill="{DynamicResource NavInkAbout}" />
                                <TextBlock Text="{DynamicResource SettingsAbout}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <TextBlock x:Name="NavVersionText" Grid.Row="2" Margin="11,12,8,0"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Column="1" Margin="2,14,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The fixed page header: title and description on the reading-start side, the pane's
                         commands on the other. The pages scroll under it (WINDOWS-UI 2.3). -->
                    <Grid Grid.Row="0" Margin="6,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel>
                                <local:ExchangeMarkIcon x:Name="ExchangePageMark" DipSize="24" DockPanel.Dock="Left"
                                                        Margin="0,0,8,0" VerticalAlignment="Top" Visibility="Collapsed" />
                                <TextBlock x:Name="PageTitleText" FontSize="{DynamicResource UiFontTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock x:Name="PageDescText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                            <!-- SP-0230: the help button leads the pane's commands, on the reading-start side of
                                 the search box, so each existing control keeps its place (CONTEXT-HELP rule 2). -->
                            <Button x:Name="HelpButton" Style="{StaticResource HelpGlyphButton}" Margin="0,0,6,0"
                                    ToolTip="{DynamicResource HelpTip}" AutomationProperties.Name="{DynamicResource HelpName}" />
                            <TextBox x:Name="SettingsSearchBox" local:HelpAnchor.Id="e-search" Style="{StaticResource SettingsSearchBoxStyle}"
                                     Margin="0,0,6,0" TextChanged="SettingsSearch_TextChanged"
                                     PreviewKeyDown="SettingsSearchBox_KeyDown" />
                            <Button x:Name="ExpandAllButton" Style="{StaticResource SettingsExpandAllGlyphButton}"
                                    Click="SettingsExpandAll_Click" Margin="0,0,4,0"
                                    ToolTip="{DynamicResource SettingsExpandAll}"
                                    AutomationProperties.Name="{DynamicResource SettingsExpandAll}" />
                            <Button x:Name="CollapseAllButton" Style="{StaticResource SettingsCollapseAllGlyphButton}"
                                    Click="SettingsCollapseAll_Click" Margin="4,0,0,0"
                                    ToolTip="{DynamicResource SettingsCollapseAll}"
                                    AutomationProperties.Name="{DynamicResource SettingsCollapseAll}" />
                        </StackPanel>
                    </Grid>
                    <Separator Grid.Row="1" Margin="0,0,0,12" Background="{DynamicResource BorderBrush}" />

                    <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- One page host per destination; exactly one is visible at a time. -->
                            <StackPanel x:Name="PageGeneral" Margin="0,0,4,0">
                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="general.basics" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource SettingsGeneralBasics}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <Grid Style="{StaticResource ValueRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" MinWidth="200" />
                                                <ColumnDefinition Width="*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource NavIcon}" FlowDirection="LeftToRight"
                                                          Data="{StaticResource Icon.app.language}" Fill="{DynamicResource NavInkGeneral}" />
                                                    <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource MachineTranslationNotice}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="LanguageBox" local:HelpAnchor.Id="e-language" Grid.Column="1" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{DynamicResource Language}"
                                                      SelectionChanged="LanguageBox_SelectionChanged" />
                                        </Grid>
                                        <Grid Style="{StaticResource ValueRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" MinWidth="200" />
                                                <ColumnDefinition Width="*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{DynamicResource ThemeHint}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="ThemeBox" local:HelpAnchor.Id="e-theme" Grid.Column="1" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{DynamicResource ThemeLabel}"
                                                      SelectionChanged="ThemeBox_SelectionChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- SP-0231 (UI-SIZING 1.1): the two choices that define the interface's measurements. Both apply
                                     at once and are remembered in ui-profile.json; neither moves a target under an active
                                     interaction, because they change only on this explicit choice. -->
                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="general.interface" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource SettingsGeneralInterface}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <Grid Style="{StaticResource ValueRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" MinWidth="200" />
                                                <ColumnDefinition Width="*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource InterfaceSizeLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{DynamicResource InterfaceSizeHint}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="InterfaceSizeBox" local:HelpAnchor.Id="e-interface-size" Grid.Column="1" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{DynamicResource InterfaceSizeLabel}"
                                                      SelectionChanged="InterfaceSizeBox_SelectionChanged" />
                                        </Grid>
                                        <Grid Style="{StaticResource ValueRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" MinWidth="200" />
                                                <ColumnDefinition Width="*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource InputProfileLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{DynamicResource InputProfileHint}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="InputProfileBox" local:HelpAnchor.Id="e-input-profile" Grid.Column="1" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{DynamicResource InputProfileLabel}"
                                                      SelectionChanged="InputProfileBox_SelectionChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="general.view" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource SettingsGeneralView}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <Grid Style="{StaticResource ValueRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" MinWidth="200" />
                                                <ColumnDefinition Width="*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource StreamTileSizeLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{DynamicResource TileSizeHint}" Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,12,0" />
                                            </StackPanel>
                                            <ComboBox x:Name="TileSizeBox" local:HelpAnchor.Id="e-tile-size" Grid.Column="1" VerticalAlignment="Top"
                                                      AutomationProperties.Name="{DynamicResource StreamTileSizeLabel}"
                                                      SelectionChanged="TileSizeBox_SelectionChanged" />
                                        </Grid>
                                        <!-- SP-0231: the first option on the BOOLEAN-OPTION row. The explanation says what the option does, so no
                                             help button: the caption and the visible text already let the user understand both states. -->
                                        <local:BooleanOptionRow x:Name="AnimatedBackdropOption" local:HelpAnchor.Id="e-animated-backdrop"
                                                                Caption="{DynamicResource AnimatedBackdrop}"
                                                                Explanation="{DynamicResource AnimatedBackdropHint}"
                                                                Toggled="AnimatedBackdropOption_Toggled" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <StackPanel x:Name="PageLibrary" Margin="0,0,4,0" Visibility="Collapsed">
                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="library.filters" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource SettingsContentFilters}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <CheckBox x:Name="HideAdultContentCheckBox" local:HelpAnchor.Id="e-hide-adult" Click="HideAdultContentCheckBox_Click"
                                                  Content="{DynamicResource HideAdultContent}"
                                                  ToolTip="{DynamicResource HideAdultContentTip}"
                                                  AutomationProperties.Name="{DynamicResource HideAdultContent}" />
                                        <TextBlock Text="{DynamicResource HideAdultContentHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="22,4,0,10" />

                                        <CheckBox x:Name="UpdatePreviewsCheckBox" local:HelpAnchor.Id="e-update-previews" Click="UpdatePreviewsCheckBox_Click"
                                                  Content="{DynamicResource UpdateStreamPreviews}"
                                                  ToolTip="{DynamicResource UpdateStreamPreviewsTip}"
                                                  AutomationProperties.Name="{DynamicResource UpdateStreamPreviews}" />
                                        <TextBlock Text="{DynamicResource UpdateStreamPreviewsHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="22,4,0,4" />

                                        <Button x:Name="ManageHiddenButton" local:HelpAnchor.Id="e-hidden" Style="{StaticResource HiddenGlyphButton}"
                                                HorizontalAlignment="Left" Margin="0,10,0,4"
                                                Content="{DynamicResource ManageHiddenOpen}" Click="ManageHidden_Click"
                                                ToolTip="{DynamicResource ManageHiddenTip}"
                                                AutomationProperties.Name="{DynamicResource ManageHiddenOpen}" />
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="library.catalog" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource StreamCatalogSettings}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource StreamCatalogSettingsHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Button x:Name="ImportCatalogFromFileButton" local:HelpAnchor.Id="e-import-catalog" Style="{StaticResource ImportGlyphButton}"
                                                HorizontalAlignment="Left"
                                                Content="{DynamicResource ImportCatalogFromFile}" Click="ImportCatalogFromFile_Click"
                                                ToolTip="{DynamicResource ImportCatalogFromFileTip}"
                                                AutomationProperties.Name="{DynamicResource ImportCatalogFromFile}" />

                                        <TextBlock Text="{DynamicResource CatalogSnapshotSettingsHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,10,0,8" />
                                        <Button x:Name="ApplyCatalogSnapshotButton" local:HelpAnchor.Id="e-builtin-list" Style="{StaticResource ImportGlyphButton}"
                                                HorizontalAlignment="Left" Content="{DynamicResource CatalogSnapshotSettings}"
                                                Click="ApplyCatalogSnapshot_Click" ToolTip="{DynamicResource CatalogSnapshotSettingsTip}"
                                                AutomationProperties.Name="{DynamicResource CatalogSnapshotSettings}" />

                                        <TextBlock Text="{DynamicResource DeleteDownloadedHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,10,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="DeleteDownloadedButton" local:HelpAnchor.Id="e-delete-downloaded" Style="{StaticResource DeleteGlyphButton}"
                                                    Content="{DynamicResource DeleteDownloaded}"
                                                    Click="DeleteDownloaded_Click" ToolTip="{DynamicResource DeleteDownloadedTip}"
                                                    AutomationProperties.Name="{DynamicResource DeleteDownloaded}" Margin="0,0,10,0" />
                                            <Button x:Name="DeleteImportedCatalogButton" local:HelpAnchor.Id="e-delete-imported" Style="{StaticResource DeleteGlyphButton}"
                                                    Content="{DynamicResource DeleteImportedCatalog}"
                                                    Click="DeleteImportedCatalog_Click" ToolTip="{DynamicResource DeleteImportedCatalogTip}"
                                                    AutomationProperties.Name="{DynamicResource DeleteImportedCatalog}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="library.playlists" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource PlaylistPortability}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PlaylistPortabilityHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="ImportFromFileButton" local:HelpAnchor.Id="e-import-file" Style="{StaticResource ImportGlyphButton}"
                                                    Content="{DynamicResource ImportFromFile}" Click="ImportFromFile_Click"
                                                    ToolTip="{DynamicResource ImportListTip}" Margin="0,0,8,0" />
                                            <Button x:Name="ImportFromUrlButton" local:HelpAnchor.Id="e-import-url" Style="{StaticResource ImportGlyphButton}"
                                                    Content="{DynamicResource ImportFromUrl}" Click="ImportFromUrl_Click"
                                                    ToolTip="{DynamicResource ImportListTip}" Margin="0,0,8,0" />
                                            <Button x:Name="ExportAllButton" local:HelpAnchor.Id="e-export-all" Style="{StaticResource ExportGlyphButton}"
                                                    Content="{DynamicResource ExportAll}" Click="ExportAll_Click"
                                                    ToolTip="{DynamicResource ExportListTip}" Margin="0,0,8,0" />
                                            <Button x:Name="ExportPinnedButton" local:HelpAnchor.Id="e-export-pinned" Style="{StaticResource ExportGlyphButton}"
                                                    Content="{DynamicResource ExportPinned}" Click="ExportPinned_Click"
                                                    ToolTip="{DynamicResource ExportListTip}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>

                                <Expander Style="{StaticResource SettingsGroup}" local:SettingsUiProperties.GroupId="library.tv" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="{DynamicResource TvScheduleTitle}" TextWrapping="Wrap" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource TvScheduleHint}" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Grid Style="{StaticResource ValueRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" MinWidth="200" />
                                                <ColumnDefinition Width="*" MaxWidth="300" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource TvScheduleAddressName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBox x:Name="TvScheduleAddressBox" local:HelpAnchor.Id="e-tv-address" Grid.Column="1" Padding="6,4" VerticalAlignment="Top"
                                                     AutomationProperties.Name="{DynamicResource TvScheduleAddressName}"
                                                     ToolTip="{DynamicResource TvScheduleAddressName}" />
                                        </Grid>
                                        <TextBlock x:Name="TvScheduleStatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="TvScheduleDownloadButton" local:HelpAnchor.Id="e-tv-download" Style="{StaticResource DownloadGlyphButton}"
                                                    Content="{DynamicResource TvScheduleDownload}" Click="TvScheduleDownload_Click"
                                                    ToolTip="{DynamicResource TvScheduleDownloadTip}"
                                                    AutomationProperties.Name="{DynamicResource TvScheduleDownload}" Margin="0,0,8,0" />
