<Window x:Class="StreamsPlayer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource SettingsWindowTitle}" Width="720" Height="640"
        MinWidth="640" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <!-- Monochrome tab-strip icon: an ICON-SET glyph (Glyphs.xaml), filled, at the 20 tier, never
             mirrored (SP-0113). -->
        <Style x:Key="TabIcon" TargetType="Path">
            <!-- The 24 grid drawn at the 20 tier: scaled as a whole, so every tab glyph keeps its own margin
                 (ICON-RENDER 5) instead of being stretched to its ink. -->
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.8333" ScaleY="0.8333" />
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl TabStripPlacement="Left" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" Padding="14">

            <!-- SP-0050 decision 4: first in the strip and marked with a globe. A user who cannot read the
                 interface reaches the gear in the header and then this tab without reading a word; folding
                 the chooser into an existing tab would have hidden it behind one. The double-click and
                 Enter handlers the standalone picker had are deliberately not carried over: inside a
                 tabbed dialog the window's own Save button is the commit, and a double-click that closed
                 the whole settings window would be a surprise. -->
            <!-- SP-0064: a composite header gives a TabItem no automation name, so every tab states its own.
                 The value is the label resource the header already shows - the tab strip is the window's
                 primary navigation, and without it neither a screen reader nor a UIA-driven check can name
                 the tab it is on. -->
            <TabItem AutomationProperties.Name="{DynamicResource Language}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.pending.app.language}" />
                        <TextBlock Text="{DynamicResource Language}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource MachineTranslationNotice}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="2,10,2,0" />
                    <!--
                        A ListBox rather than thirteen checkable entries: arrow keys, Home/End,
                        PageUp/PageDown and type-to-select all come for free. Each row is named in its own
                        language, so the list is usable by someone who cannot read the other twelve.
                    -->
                    <!-- Transparent over the tab's own themed background, as every other list in the app
                         does: App.xaml carries an implicit style for ListView but none for ListBox, so a
                         ListBox that states no background keeps WPF's white default while its items take
                         the theme's light TextBrush - unreadable in the dark theme. -->
                    <ListBox x:Name="LanguageList" SelectionMode="Single"
                             AutomationProperties.Name="{DynamicResource LanguagePickerName}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" Padding="2">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Endonym}" FontSize="15" VerticalAlignment="Center" />
                                    <!-- A check mark rather than a localized word: it needs no translation, so the
                                         picker adds no key to thirteen dictionaries, and it survives a screenshot
                                         and a high-contrast theme. Screen readers learn which entry is active from
                                         the selection pattern - the active language is selected when the tab
                                         opens - so nothing is lost by the marker being a picture. SP-0113: the
                                         same drawn tick as a checked menu item, not a font's text symbol. -->
                                    <Path Grid.Column="1" Data="{StaticResource Chrome.menu-check}"
                                          Visibility="{Binding ActiveMarkerVisibility}"
                                          Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="8,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Grid / Layout -->
            <TabItem AutomationProperties.Name="{DynamicResource GridSettings}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.view.grid}" />
                        <TextBlock Text="{DynamicResource GridSettings}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <!-- Every tab whose body is a plain stack scrolls: the window is resizable, but a tab that
                     outgrows the smallest allowed height must still reach its last control. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource ThemeLabel}" FontWeight="SemiBold" />
                        <ComboBox x:Name="ThemeBox" Margin="0,5,0,12" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{DynamicResource ThemeLabel}" />
                        <TextBlock Text="{DynamicResource StreamTileSizeLabel}" FontWeight="SemiBold" />
                        <ComboBox x:Name="TileSizeBox" Margin="0,5,0,12" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{DynamicResource StreamTileSizeLabel}" />
                        <CheckBox x:Name="UpdatePreviewsCheckBox" Content="{DynamicResource UpdateStreamPreviews}"
                                  ToolTip="{DynamicResource UpdateStreamPreviewsTip}"
                                  AutomationProperties.Name="{DynamicResource UpdateStreamPreviews}" />
                        <CheckBox x:Name="HideAdultContentCheckBox" Margin="0,10,0,0"
                                  Content="{DynamicResource HideAdultContent}"
                                  ToolTip="{DynamicResource HideAdultContentTip}"
                                  AutomationProperties.Name="{DynamicResource HideAdultContent}" />
                        <CheckBox x:Name="AnimatedBackdropCheckBox" Margin="0,10,0,0"
                                  ToolTip="{DynamicResource AnimatedBackdropTip}"
                                  AutomationProperties.Name="{DynamicResource AnimatedBackdrop}">
                            <TextBlock Text="{DynamicResource AnimatedBackdrop}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Playback -->
            <TabItem AutomationProperties.Name="{DynamicResource PlaybackSettings}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.media.play}" />
                        <TextBlock Text="{DynamicResource PlaybackSettings}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <CheckBox x:Name="KeepAwakeCheckBox" ToolTip="{DynamicResource KeepAwakeDuringPlaybackTip}"
                                  AutomationProperties.Name="{DynamicResource KeepAwakeDuringPlayback}">
                            <TextBlock Text="{DynamicResource KeepAwakeDuringPlayback}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="SystemMediaControlsCheckBox" Margin="0,10,0,0"
                                  ToolTip="{DynamicResource SystemMediaControlsTip}"
                                  AutomationProperties.Name="{DynamicResource SystemMediaControls}">
                            <TextBlock Text="{DynamicResource SystemMediaControls}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="ResumePlaybackCheckBox" Margin="0,10,0,0"
                                  ToolTip="{DynamicResource ResumePlaybackOnStartupTip}"
                                  AutomationProperties.Name="{DynamicResource ResumePlaybackOnStartup}">
                            <TextBlock Text="{DynamicResource ResumePlaybackOnStartup}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource VideoBackendLabel}" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <ComboBox x:Name="VideoBackendBox" Margin="0,5,0,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{DynamicResource VideoBackendLabel}" />
                        <TextBlock Text="{DynamicResource VideoBackendHint}" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <!-- SP-0026: the alternative engine needs FFmpeg natives that are not shipped. This
                             states whether they are present so the engine choice above cannot silently mean
                             nothing. SP-0109: installing and removing them is an operation, not a value, so it
                             lives in the Tools window and this line only says where. -->
                        <TextBlock x:Name="VideoComponentsStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{DynamicResource VideoComponentsWhere}" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <!-- SP-0038: where the player's camera button writes its frames. Read-only text plus a
                             picker, so the stored path is always one Windows itself produced. -->
                        <TextBlock Text="{DynamicResource FrameFolderLabel}" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBox x:Name="FrameFolderBox" IsReadOnly="True" Margin="0,5,0,0" Padding="7,4"
                                 TextWrapping="NoWrap" AutomationProperties.Name="{DynamicResource FrameFolderLabel}" />
                        <TextBlock Text="{DynamicResource FrameFolderHint}" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="FrameFolderBrowseButton" Style="{StaticResource ChooseFolderGlyphButton}"
                                    Content="{DynamicResource FrameFolderBrowse}" Click="FrameFolderBrowse_Click" Margin="0,0,8,0" />
                            <Button x:Name="FrameFolderResetButton" Style="{StaticResource ResetGlyphButton}"
                                    Content="{DynamicResource FrameFolderReset}" Click="FrameFolderReset_Click" Margin="0,0,8,0" />
                            <Button x:Name="FrameFolderOpenButton" Style="{StaticResource OpenFolderGlyphButton}"
                                    Content="{DynamicResource FrameFolderOpen}" Click="FrameFolderOpen_Click"
                                    ToolTip="{DynamicResource LogArchiveOpenFolder}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About -->
            <TabItem AutomationProperties.Name="{DynamicResource About}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource TabIcon}" FlowDirection="LeftToRight" Data="{StaticResource Icon.app.info}" />
                        <TextBlock Text="{DynamicResource About}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="{DynamicResource ProductName}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <!-- SP-0050 decision 5: the tagline is a sentence read once. This is where a product
                             describes itself; it does not need a permanent line in a working window. -->
                        <TextBlock Text="{DynamicResource MainSubtitle}" Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Grid Margin="0,8,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource VersionLabel}" FontWeight="SemiBold" Margin="0,0,10,5" />
                            <TextBlock x:Name="VersionText" Grid.Column="1" Margin="0,0,0,5" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource AuthorLabel}" FontWeight="SemiBold" Margin="0,0,10,0" />
                            <TextBlock x:Name="AuthorText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                        <WrapPanel>
                            <TextBlock Margin="0,0,18,8">
                                <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Instructions"
                                           Click="OpenLink_Click" ToolTip="{DynamicResource DocumentationTip}"
                                           AutomationProperties.Name="{DynamicResource Documentation}">
                                    <Run Text="{DynamicResource Documentation}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,18,8">
                                <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Source"
                                           Click="OpenLink_Click" ToolTip="{DynamicResource SourceCodeTip}"
                                           AutomationProperties.Name="{DynamicResource SourceCode}">
                                    <Run Text="{DynamicResource SourceCode}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,18,8">
                                <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Website"
                                           Click="OpenLink_Click" ToolTip="{DynamicResource WebsiteTip}"
                                           AutomationProperties.Name="{DynamicResource Website}">
                                    <Run Text="{DynamicResource Website}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,18,8">
                                <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Privacy"
                                           Click="OpenLink_Click" ToolTip="{DynamicResource PrivacyTip}"
                                           AutomationProperties.Name="{DynamicResource Privacy}">
                                    <Run Text="{DynamicResource Privacy}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,0,18,8">
                                <Hyperlink Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Tag="Author"
                                           Click="OpenLink_Click" ToolTip="{DynamicResource AuthorPageTip}"
                                           AutomationProperties.Name="{DynamicResource AuthorPage}">
                                    <Run Text="{DynamicResource AuthorPage}" />
                                </Hyperlink>
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- SP-0109: this window holds values only - every control above edits a pending value or opens
             something without changing anything, so Save is the one commit and Cancel keeps its promise
             (APP-BEHAVIOUR rule 12). Operations live in the Tools window. IsCancel makes Escape the same
             no-action exit as this button and the close box (rule 1); DesktopUxConformanceTests holds both. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource CancelGlyphButton}" Content="{DynamicResource Cancel}" Click="Cancel_Click"
                    IsCancel="True" />
            <Button Style="{StaticResource SaveGlyphButton}" Content="{DynamicResource Save}" Click="Save_Click"
                    IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
