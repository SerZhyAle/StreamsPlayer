                                            <Button x:Name="DriveSignInButton" local:HelpAnchor.Id="e-drive-sign-in" Style="{StaticResource ExchangeConnectGlyphButton}" Content="{DynamicResource DriveSignIn}" Click="DriveSignIn_Click" Margin="0,0,8,8" />
                                            <Button x:Name="DriveSignOutButton" local:HelpAnchor.Id="e-drive-sign-out" Style="{StaticResource RemoveGlyphButton}" Content="{DynamicResource DriveSignOut}" Click="DriveSignOut_Click" Margin="0,0,8,8" />
                                            <Button x:Name="DriveCancelButton" Style="{StaticResource CancelGlyphButton}" Content="{DynamicResource Cancel}" Click="DriveCancel_Click" Margin="0,0,8,8" Visibility="Collapsed" />
                                        </WrapPanel>
                                        <TextBlock x:Name="DriveStatusText" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- SP-0221 requirement 9: guest accounts held beside the own one - labelled, bounded, each
                                         signed out on its own. A guest entry is never connected or announced from here. -->
                                    <StackPanel x:Name="ExchangeGuestPanel" Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource ExchangeGuests}" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ExchangeGuestBoundText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                                        <StackPanel x:Name="ExchangeGuestList" />
                                        <DockPanel Margin="0,4,0,0">
                                            <local:ExchangeMarkIcon DipSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,6,0">
                                                <local:ExchangeMarkIcon.Style>
                                                    <Style TargetType="local:ExchangeMarkIcon">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ExchangeGuestStatusText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:ExchangeMarkIcon.Style>
                                            </local:ExchangeMarkIcon>
                                            <TextBlock x:Name="ExchangeGuestStatusText" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="PageBroadcast" Margin="0,0,4,0" Visibility="Collapsed">
                                <StackPanel x:Name="BroadcastGroup" local:SettingsUiProperties.GroupId="library.broadcast" Margin="6,0,0,0">
                                    <DockPanel Margin="0,0,0,8">
                                        <Path Data="{StaticResource Icon.feature.server-relay}" Width="24" Height="24" Stretch="Uniform" FlowDirection="LeftToRight"
                                              Fill="{DynamicResource TextBrush}" VerticalAlignment="Top" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource BroadcastHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <Button Style="{StaticResource SettingsLinkButton}" Tag="ExchangeBroadcasts" Click="OpenLink_Click" HorizontalAlignment="Left" Margin="0,0,0,8"
                                            ToolTip="{DynamicResource MediaExchangeTip}" AutomationProperties.Name="{DynamicResource MediaExchange}" Content="{DynamicResource MediaExchange}" />
                                    <!-- SP-0221 requirement 8: a guest announces nothing on its server, and says why here. -->
                                    <TextBlock x:Name="BroadcastGuestNoteText" Text="{DynamicResource BroadcastGuestOnly}" TextWrapping="Wrap"
                                               Visibility="Collapsed" Margin="0,0,0,8" />
                                    <CheckBox x:Name="BroadcastAllowedCheckBox" local:HelpAnchor.Id="e-broadcast-allow" Content="{DynamicResource BroadcastAllow}"
                                              Checked="BroadcastAllowed_Click" Unchecked="BroadcastAllowed_Click" Margin="0,0,0,8" />
                                    <StackPanel x:Name="BroadcastControls" Visibility="Collapsed">
                                        <CheckBox x:Name="BroadcastStartWithAppCheckBox" local:HelpAnchor.Id="e-broadcast-start-with-app" Content="{DynamicResource BroadcastStartWithApp}"
                                                  Checked="BroadcastStartWithApp_Click" Unchecked="BroadcastStartWithApp_Click" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button x:Name="BroadcastMicButton" local:HelpAnchor.Id="e-broadcast-mic" Style="{StaticResource BroadcastingGlyphButton}" Content="{DynamicResource BroadcastMicStart}" Click="BroadcastMicStart_Click" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource BroadcastMicStart}" />
                                            <Button x:Name="BroadcastSoundButton" local:HelpAnchor.Id="e-broadcast-sound" Style="{StaticResource BroadcastingGlyphButton}" Content="{DynamicResource BroadcastSoundStart}" Click="BroadcastSoundStart_Click" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource BroadcastSoundStart}" />
                                            <Button x:Name="BroadcastScreenButton" local:HelpAnchor.Id="e-broadcast-screen" Style="{StaticResource BroadcastingGlyphButton}" Content="{DynamicResource BroadcastScreenStart}" Click="BroadcastScreenStart_Click" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource BroadcastScreenStart}" />
                                            <Button x:Name="BroadcastCameraButton" local:HelpAnchor.Id="e-broadcast-camera" Style="{StaticResource BroadcastingGlyphButton}" Content="{DynamicResource BroadcastCameraStart}" Click="BroadcastCameraStart_Click" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource BroadcastCameraStart}" />
                                            <Button x:Name="BroadcastStopButton" local:HelpAnchor.Id="e-broadcast-stop" Style="{StaticResource RemoveGlyphButton}" Content="{DynamicResource BroadcastStopAll}" Click="BroadcastStopAll_Click" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource BroadcastStopAll}" />
                                        </WrapPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource BroadcastMicDevice}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="BroadcastMicDeviceBox" local:HelpAnchor.Id="e-broadcast-mic-device" Grid.Row="0" Grid.Column="1" SelectionChanged="BroadcastMicDevice_Changed" Margin="0,0,0,8"
                                                      AutomationProperties.Name="{DynamicResource BroadcastMicDevice}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource BroadcastLanListening}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                                <CheckBox x:Name="BroadcastLanCheckBox" local:HelpAnchor.Id="e-broadcast-lan" Checked="BroadcastLan_Click" Unchecked="BroadcastLan_Click" VerticalAlignment="Center" />
                                                <TextBlock x:Name="BroadcastLanPortLabel" Text="{DynamicResource BroadcastLanPort}" VerticalAlignment="Center" Margin="12,0,8,0" />
                                                <TextBox x:Name="BroadcastLanPortBox" local:HelpAnchor.Id="e-broadcast-lan-port" Width="70" TextChanged="BroadcastLanPort_TextChanged" AutomationProperties.Name="{DynamicResource BroadcastLanPort}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource BroadcastCap}" VerticalAlignment="Top" Margin="0,0,8,8" />
                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                                <TextBox x:Name="BroadcastCapBox" local:HelpAnchor.Id="e-broadcast-cap" Width="70" TextChanged="BroadcastCap_TextChanged" AutomationProperties.Name="{DynamicResource BroadcastCap}" />
                                                <TextBlock Text="{DynamicResource BroadcastCapHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource BroadcastQuality}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                                <TextBlock Text="{DynamicResource BroadcastSampleRate}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="BroadcastSampleRateBox" local:HelpAnchor.Id="e-broadcast-sample-rate" Width="90" SelectionChanged="BroadcastQuality_Changed" AutomationProperties.Name="{DynamicResource BroadcastSampleRate}" Margin="0,0,12,0" />
                                                <TextBlock Text="{DynamicResource BroadcastMicChannels}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="BroadcastMicChannelsBox" local:HelpAnchor.Id="e-broadcast-mic-channels" Width="90" SelectionChanged="BroadcastQuality_Changed" AutomationProperties.Name="{DynamicResource BroadcastMicChannels}" Margin="0,0,12,0" />
                                                <TextBlock Text="{DynamicResource BroadcastSoundChannels}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="BroadcastSoundChannelsBox" local:HelpAnchor.Id="e-broadcast-sound-channels" Width="90" SelectionChanged="BroadcastQuality_Changed" AutomationProperties.Name="{DynamicResource BroadcastSoundChannels}" Margin="0,0,12,0" />
                                                <TextBlock Text="{DynamicResource BroadcastBitrate}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="BroadcastBitrateBox" local:HelpAnchor.Id="e-broadcast-bitrate" Width="90" SelectionChanged="BroadcastQuality_Changed" AutomationProperties.Name="{DynamicResource BroadcastBitrate}" />
                                            </WrapPanel>
                                        </Grid>
                                        <!-- SP-0223: the screen and camera sources. Hidden, with the reason, where Windows' H.264 encoder is absent. -->
                                        <StackPanel x:Name="BroadcastVideoGroup" Margin="0,0,0,8">
                                            <TextBlock x:Name="BroadcastVideoUnavailableText" Text="{DynamicResource BroadcastVideoUnavailable}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
                                            <Grid x:Name="BroadcastVideoGrid">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource BroadcastMonitor}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <ComboBox x:Name="BroadcastMonitorBox" local:HelpAnchor.Id="e-broadcast-monitor" Grid.Row="0" Grid.Column="1" SelectionChanged="BroadcastMonitor_Changed" Margin="0,0,0,8"
                                                          AutomationProperties.Name="{DynamicResource BroadcastMonitor}" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource BroadcastScreenAudio}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <ComboBox x:Name="BroadcastScreenAudioBox" local:HelpAnchor.Id="e-broadcast-screen-audio" Grid.Row="1" Grid.Column="1" SelectionChanged="BroadcastVideoAudio_Changed" Margin="0,0,0,8"
                                                          AutomationProperties.Name="{DynamicResource BroadcastScreenAudio}" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource BroadcastCamera}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <ComboBox x:Name="BroadcastCameraBox" local:HelpAnchor.Id="e-broadcast-camera-device" Grid.Row="2" Grid.Column="1" SelectionChanged="BroadcastCamera_Changed" Margin="0,0,0,8"
                                                          AutomationProperties.Name="{DynamicResource BroadcastCamera}" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource BroadcastCameraAudio}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <ComboBox x:Name="BroadcastCameraAudioBox" local:HelpAnchor.Id="e-broadcast-camera-audio" Grid.Row="3" Grid.Column="1" SelectionChanged="BroadcastVideoAudio_Changed" Margin="0,0,0,8"
                                                          AutomationProperties.Name="{DynamicResource BroadcastCameraAudio}" />
                                            </Grid>
                                            <TextBlock x:Name="BroadcastScreenPrivacyText" Text="{DynamicResource BroadcastScreenPrivacy}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        </StackPanel>
                                        <TextBlock x:Name="BroadcastOwnOutputText" Text="{DynamicResource BroadcastOwnOutputRisk}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
                                        <!-- LIVE-BROADCAST item R: the outward link's password is the person's choice. -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource BroadcastLinkPassword}" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="BroadcastLinkChoiceBox" local:HelpAnchor.Id="e-broadcast-link-password" Grid.Row="0" Grid.Column="1" SelectionChanged="BroadcastLinkChoice_Changed" Margin="0,0,0,8"
                                                      AutomationProperties.Name="{DynamicResource BroadcastLinkPassword}" />
                                            <StackPanel x:Name="BroadcastLinkCustomPanel" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                                <PasswordBox x:Name="BroadcastLinkPasswordBox" local:HelpAnchor.Id="e-broadcast-link-custom" Width="220" MaxLength="256" Margin="0,0,8,0"
                                                             AutomationProperties.Name="{DynamicResource BroadcastLinkPasswordField}" />
                                                <Button x:Name="BroadcastLinkSaveButton" local:HelpAnchor.Id="e-broadcast-link-save" Style="{StaticResource SaveGlyphButton}" Content="{DynamicResource BroadcastLinkPasswordSave}" Click="BroadcastLinkSave_Click"
                                                        AutomationProperties.Name="{DynamicResource BroadcastLinkPasswordSave}" />
                                            </StackPanel>
                                        </Grid>
                                        <Button x:Name="BroadcastLinkRenewButton" local:HelpAnchor.Id="e-broadcast-link-renew" Style="{StaticResource BroadcastingGlyphButton}" Content="{DynamicResource BroadcastLinkRenew}" Click="BroadcastLinkRenew_Click"
                                                HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource BroadcastLinkRenew}" />
                                        <TextBlock x:Name="BroadcastLinkNoneText" Text="{DynamicResource BroadcastLinkNoneWarning}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
                                        <TextBlock Text="{DynamicResource BroadcastLinkHint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <TextBlock x:Name="BroadcastStatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- The settings search's result list: the caption and the page and group it lives in
                         (WINDOWS-UI 3.5); activating one navigates - page, expanded group, scrolled and
                         focused row (3.4). -->
                    <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SettingsSearchBox}"
                           Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="3" MinWidth="240" MaxWidth="360" Margin="0,2,0,4">
                            <ListBox x:Name="SearchResultsList" BorderThickness="0" Background="Transparent"
                                     MaxHeight="280" VerticalContentAlignment="Top"
                                     PreviewMouseLeftButtonUp="SearchResultsList_Click"
                                     KeyDown="SearchResultsList_KeyDown" />
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom bar: VideoComponentsCancelButton (left, for long operation) -->
        <Button x:Name="VideoComponentsCancelButton" Style="{StaticResource CancelGlyphButton}" Grid.Row="1" HorizontalAlignment="Left" Margin="0,14,0,0"
                Padding="14,6" Visibility="Collapsed"
                Content="{DynamicResource VideoComponentsCancel}" Click="VideoComponentsCancel_Click"
                AutomationProperties.Name="{DynamicResource VideoComponentsCancel}" />
    </Grid>
</Window>
