<Window x:Class="StreamsPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:StreamsPlayer.Core;assembly=StreamsPlayer.Core"
        xmlns:local="clr-namespace:StreamsPlayer.App"
        xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        mc:Ignorable="PresentationOptions"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource ProductName}" Height="780" Width="1180" MinHeight="560" MinWidth="820"
        Background="{DynamicResource WindowBackground}"
        AllowDrop="True" PreviewDragOver="MainWindow_PreviewDragOver" Drop="MainWindow_Drop">
    <Window.Resources>
        <!-- SP-0050 decision 7: a hidden row must never narrow the catalog silently. The accent border
             is the same "away from All" vocabulary MinBitrateFilter already uses, so the mark reads as
             an existing signal rather than a new one. MainWindow.FilterPanel.cs drives the Tag. -->
        <Style x:Key="FiltersRevealButton" TargetType="Button" BasedOn="{StaticResource FilterGlyphButton}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- SP-0061: General is 48.2% of the bank, so the rubric facet shows it last (TopicLabels.Comparer)
             and rules it off from the rubrics that actually narrow the list. The rule is a border rather
             than a Separator item because a Separator in an ItemsSource still generates a selectable
             container. The identifier has one home in Core; do not retype it here. -->
        <Style x:Key="TopicFacetItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="{x:Static core:CatalogTopics.General}">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- SP-0102: Search box with integrated watermark and search icon, removing external label -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="24,5,6,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="12" Height="12" Margin="6,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Path Data="{StaticResource Icon.action.search}" Width="24" Height="24" FlowDirection="LeftToRight"
                                          Fill="{DynamicResource MutedBrush}" />
                                </Viewbox>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Margin="0" />
                                <TextBlock x:Name="SearchWatermark" Grid.Column="1" Text="{DynamicResource SearchCatalog}"
                                           Foreground="{DynamicResource DisabledTextBrush}" VerticalAlignment="Center"
                                           Margin="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="SearchWatermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- SP-0102: Segmented mode buttons with active state highlight -->
        <Style x:Key="SegmentedListButton" TargetType="Button" BasedOn="{StaticResource ListGlyphButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="1,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SegmentedGridButton" TargetType="Button" BasedOn="{StaticResource GridGlyphButton}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="1,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- SP-0050: the title line carries the product name, the search field and the one control
                 that reveals the filter row. It scales inside a DownOnly Viewbox - the same mechanism the
                 filter band uses - so the longest labels shrink at the minimum window width instead of
                 clipping the product name or collapsing the search field. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ProductName}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBoxStyle}" Width="200"
                             ToolTip="{DynamicResource SearchTip}" TextChanged="FilterChanged"
                             VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource SearchName}" />
                    <Button Style="{StaticResource ClearInputGlyphButton}" Click="ClearSearchButton_Click"
                            VerticalAlignment="Center" ToolTip="{DynamicResource ClearTip}" AutomationProperties.Name="{DynamicResource ClearTip}" />
                    <Button x:Name="FiltersButton" Style="{StaticResource FiltersRevealButton}"
                            Content="{DynamicResource FiltersAndSorting}" Click="FiltersButton_Click"
                            VerticalAlignment="Center" ToolTip="{DynamicResource FiltersAndSortingTip}"
                            AutomationProperties.Name="{DynamicResource FiltersAndSorting}" />
                    <!-- SP-0094: the Media facet's second form. They stay in the title line whether the
                         filter row is open or closed - unlike FiltersButton, which the open row replaces -
                         because the whole point is a switch that costs one click from wherever you are. -->
                    <Button x:Name="QuickVideoButton" Style="{StaticResource QuickVideoFilterButton}"
                            Click="QuickVideoButton_Click" VerticalAlignment="Center"
                            ToolTip="{DynamicResource QuickVideoTip}"
                            AutomationProperties.Name="{DynamicResource QuickVideoTip}" />
                    <Button x:Name="QuickAudioButton" Style="{StaticResource QuickAudioFilterButton}"
                            Click="QuickAudioButton_Click" VerticalAlignment="Center"
                            ToolTip="{DynamicResource QuickAudioTip}"
                            AutomationProperties.Name="{DynamicResource QuickAudioTip}" />
                    <Button x:Name="QuickOwnButton" Style="{StaticResource QuickOwnFilterButton}"
                            Click="QuickOwnButton_Click" VerticalAlignment="Center"
                            ToolTip="{DynamicResource QuickOwnTip}"
                            AutomationProperties.Name="{DynamicResource QuickOwnTip}" />
                </StackPanel>
            </Viewbox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- SP-0102: Segmented pair with active state highlighting -->
                <Border Background="{DynamicResource SectionBrush}" CornerRadius="4" Padding="2" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ListModeButton" Style="{StaticResource SegmentedListButton}" Content="{DynamicResource List}" Click="ListModeButton_Click"
                                ToolTip="{DynamicResource ListTip}" AutomationProperties.Name="{DynamicResource ListName}" />
                        <Button x:Name="GridModeButton" Style="{StaticResource SegmentedGridButton}" Content="{DynamicResource Grid}" Click="GridModeButton_Click"
                                ToolTip="{DynamicResource GridTip}" AutomationProperties.Name="{DynamicResource GridName}" />
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Style="{StaticResource SettingsGlyphButton}" Content="{DynamicResource Settings}" Click="SettingsButton_Click"
                        ToolTip="{DynamicResource SettingsTip}" AutomationProperties.Name="{DynamicResource SettingsName}" />
                <!-- SP-0050: the rare and the mode-conditional actions live here. The menu is rebuilt on
                     every open (MainWindow.Operations.cs), which is what keeps the always-on-top check
                     mark and the grid-only preview entry honest without a single subscription. -->
                <Button x:Name="OperationsButton" Style="{StaticResource OperationsGlyphButton}"
                        Content="{DynamicResource Operations}" Click="OperationsButton_Click"
                        ToolTip="{DynamicResource OperationsTip}" AutomationProperties.Name="{DynamicResource OperationsTip}">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="OperationsMenu" />
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- SP-0050: hidden unless the user asks for it. Collapsed in markup as well as from state, so a
             window that never reaches the state load still starts in the state the ticket calls hidden.
             SP-0102: Two-row structured layout without Viewbox scaling keeps font sizes readable (>= 11pt) on narrow windows. -->
        <Border x:Name="FilterPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Row 0: Content facets (Media, Category, Topic, Language, Country) -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <TextBlock Text="{DynamicResource Media}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="MediaFilter" Width="90" SelectionChanged="FilterChanged" ToolTip="{DynamicResource MediaKindTip}"
                                  AutomationProperties.Name="{DynamicResource MediaFilterName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <TextBlock Text="{DynamicResource Category}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="CategoryFilter" Width="110" SelectionChanged="FilterChanged" ToolTip="{DynamicResource Category}"
                                  AutomationProperties.Name="{DynamicResource CategoryFilterName}" />
                    </StackPanel>
                    <!-- SP-0061: next to category deliberately. They are the catalog's two vocabulary facets
                         over two different, disjoint column sets, and a reader compares them. -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <TextBlock Text="{DynamicResource Topic}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="TopicFilter" Width="130" SelectionChanged="FilterChanged" ToolTip="{DynamicResource Topic}"
                                  ItemContainerStyle="{StaticResource TopicFacetItem}"
                                  AutomationProperties.Name="{DynamicResource TopicFilterName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="LanguageFilter" Width="110" SelectionChanged="FilterChanged" ToolTip="{DynamicResource Language}"
                                  AutomationProperties.Name="{DynamicResource LanguageFilterName}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                        <TextBlock Text="{DynamicResource Country}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="CountryFilter" Width="80" SelectionChanged="FilterChanged" ToolTip="{DynamicResource Country}"
                                  AutomationProperties.Name="{DynamicResource CountryFilterName}" />
                    </StackPanel>
                </WrapPanel>
                <!-- Row 1: Technical & collection facets, sort order and actions -->
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- SP-0138: the shown / total count is filter feedback, so it sits beside the control
                             that undoes the filters rather than in the status bar. Written by ApplyFilter. -->
                        <TextBlock x:Name="ChannelCountText" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="ClearFiltersButton" Style="{StaticResource ClearFilterGlyphButton}"
                                Content="{DynamicResource Clear}" Click="ClearFiltersButton_Click"
                                VerticalAlignment="Center" ToolTip="{DynamicResource ClearFiltersTip}"
                                AutomationProperties.Name="{DynamicResource ClearFiltersName}" Margin="0,0,6,0" />
                        <Button x:Name="HideFiltersButton" Style="{StaticResource CloseGlyphOnlyButton}" Click="HideFiltersButton_Click"
                                VerticalAlignment="Center" ToolTip="{DynamicResource HideFilters}"
                                AutomationProperties.Name="{DynamicResource HideFilters}" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="{DynamicResource MinBitrate}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="MinBitrateFilter" Width="100" SelectionChanged="FilterChanged" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource MinBitrateTip}" AutomationProperties.Name="{DynamicResource MinBitrateName}">
                                <ComboBox.Style>
                                    <!-- BasedOn keeps the app-wide ComboBox padding/margin; without it this filter
                                         rendered shorter than its neighbours and its value sat off-centre. -->
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="SelectedValue" Value="All">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <!-- +1px padding offsets the thinner border so the value keeps the
                                                     same height and baseline in both states. -->
                                                <Setter Property="Padding" Value="6" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="{DynamicResource SortBy}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="SortMode" Width="110" SelectionChanged="FilterChanged" ToolTip="{DynamicResource SortOrderTip}"
                                      AutomationProperties.Name="{DynamicResource SortCatalogName}" />
                        </StackPanel>
                        <!-- SP-0017: one collection at a time, next to the other facets. -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,14,3">
                            <TextBlock Text="{DynamicResource CollectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="CollectionFilter" Width="130" SelectionChanged="FilterChanged" SelectedValuePath="Value"
                                      ToolTip="{DynamicResource CollectionFilterTip}" AutomationProperties.Name="{DynamicResource CollectionFilterName}" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4">
            <DockPanel>
            <Grid x:Name="CatalogArea" SizeChanged="CatalogArea_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                        <!-- SP-0161: a button, not a border with a mouse handler - it is focusable, works
                             with Enter and Space, and UI Automation exposes its InvokePattern. -->
                        <Style x:Key="SectionHeaderButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource SectionBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="3" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="StreamCardBorderStyle" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- SP-0114: the play-outcome dot on a card and on a tile. The row names a palette
                             role (ChannelRow.StatusTone) and the colour is looked up here by dynamic
                             reference, so the dot follows a theme switch with everything around it. -->
                        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Success">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Danger">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- Out of theme (APP-STYLE 5): the scrim darkens the picture under a tile's title.
                             SP-0067: one frozen brush shared by every tile, instead of one allocated per
                             realized tile. Deliberately StaticResource and deliberately not a palette
                             key: this is a fixed scrim over an image, ThemeService does not recolour it,
                             and the memory note about StaticResource is about palette keys. -->
                        <LinearGradientBrush x:Key="TileScrimBrush" StartPoint="0,0" EndPoint="0,1"
                                             PresentationOptions:Freeze="True">
                            <GradientStop Color="#00111827" Offset="0" />
                            <GradientStop Color="#E6111827" Offset="1" />
                        </LinearGradientBrush>
                        <!-- Out of theme (APP-STYLE 5): a grid tile is a picture - the channel's preview
                             frame or its monogram - on a fixed near-black backing, not a themed card. Its
                             frame colour is the one a picture needs in either theme; selection still takes
                             the theme's accent. -->
                        <Style x:Key="StreamGridTileBorderStyle" TargetType="Border">
                            <Setter Property="Background" Value="#FF111827" />
                            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                                    <Setter Property="BorderThickness" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- SP-0067: shared by all three catalog lists - the main one and the two
                             pinned ones. It was inline on the main list when there was only one list;
                             a pinned card differing from a main card by a padding would be a visible
                             regression, so there is now exactly one definition. -->
                        <Style x:Key="CatalogItemContainerStyle" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisualInset}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter ContentSource="Content"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <DataTemplate x:Key="StreamCardTemplate">
                            <!-- SP-0102: reduced MinHeight to 68 and hidden raw Channel.Url to reduce visual noise and tighten catalog rows -->
                            <Border Style="{StaticResource StreamCardBorderStyle}" CornerRadius="5" Padding="7" Margin="3" MinHeight="68"
                                    PreviewMouseLeftButtonDown="StreamCard_PreviewMouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- SP-0110 (WAVE-PARTICLES): the playing station's backdrop, first so everything else
                                         draws over it. The negative margin reaches over the card's padding to its border;
                                         the wash is the card's own background, so selection and theme reach it. Dimmed
                                         for the title it sits under (rule 16: dimmer is allowed, brighter never). -->
                                    <local:WaveParticlesBackdrop Grid.RowSpan="3" Margin="-7" CornerRadius="4"
                                                                 Session="{Binding Backdrop}" Intent="Decorative" Intensity="0.35"
                                                                 WashBrush="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}" />
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{DynamicResource FaviconPlateBrush}" CornerRadius="4"
                                                VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <!-- Out of theme (APP-STYLE 5): the plate is the channel's identity colour
                                                     (MonogramPalette), with its own ink and its own dark strip for the country.
                                                     SP-0087: shown only when the bank gave this channel no icon, and drawn *under*
                                                     the image rather than instead of it - a favicon with a transparent background
                                                     must still sit on the neutral plate and not on a colour. A collapsed Auto row
                                                     is zero high, so a channel with no country centres its monogram in the full
                                                     32 points and one with a country centres it in what the strip leaves. -->
                                                <Border Background="{Binding MonogramBrush}" CornerRadius="4"
                                                        Visibility="{Binding FaviconFallbackVisibility}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding MonogramText}" Foreground="{Binding MonogramForeground}"
                                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Row="1" Background="#59000000" Visibility="{Binding CountryCodeVisibility}">
                                                            <TextBlock Text="{Binding CountryCode}" Foreground="{Binding MonogramForeground}"
                                                                       FontSize="7" LineHeight="9" LineStackingStrategy="BlockLineHeight"
                                                                       HorizontalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Image Source="{Binding Favicon}" Width="32" Height="32" Stretch="None" />
                                            </Grid>
                                        </Border>
                                        <!-- Now-playing indicator: spins over the favicon while this station's audio plays.
                                             Out of theme (APP-STYLE 5): it is drawn over the favicon, a picture, so it
                                             carries its own opaque disc and white note - the same one the grid tile uses. -->
                                        <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Ellipse Fill="#CC2364AA" />
                                            <Path Data="{StaticResource Icon.content.audio}" FlowDirection="LeftToRight"
                                                  Fill="White" Stretch="Uniform" Margin="5" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="NoteRotateList" />
                                                </Path.RenderTransform>
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard Name="SpinNoteList">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0" To="360" Duration="0:0:1.8" RepeatBehavior="Forever" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="SpinNoteList" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                        <Ellipse Grid.Column="1" Width="10" Height="10" Style="{StaticResource StatusDotStyle}"
                                                 VerticalAlignment="Center" ToolTip="{Binding StatusLabel}"
                                                 AutomationProperties.Name="{Binding StatusLabel}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="14"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}" />
                                        <Button Grid.Column="3" Content="" ToolTip="{DynamicResource PlayTip}"
                                                AutomationProperties.Name="{DynamicResource PlayTip}" Tag="{Binding}" Click="PlayButton_Click" MinWidth="50" Padding="8,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PlayGlyphButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3" Content="{DynamicResource Stop}" ToolTip="{DynamicResource StopTip}"
                                                AutomationProperties.Name="{DynamicResource StopTip}" Tag="{Binding}" Click="PlayButton_Click" MinWidth="50" Padding="8,4"
                                                Visibility="Collapsed">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource StopGlyphButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="4" Style="{StaticResource MoreGlyphButton}" Content="" Width="32" Padding="0"
                                                Tag="{Binding}" Click="OverflowButton_Click" ToolTip="{DynamicResource MoreActionsTip}"
                                                AutomationProperties.Name="{DynamicResource MoreActionsName}" />
                                    </Grid>
                                    <!-- SP-0075: the programme on air from the user's TV schedule. It is collapsed
                                         for every channel without a schedule, so an unmatched card keeps the height
                                         and look it had before. -->
                                    <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding ScheduleNowText}"
                                               Visibility="{Binding ScheduleNowVisibility}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScheduleNowText}" />
                                    <!-- One line under the title: tags on the left, stream parameters pushed right, and the
                                         pin toggle under the overflow button so the title row keeps the width. A DockPanel,
                                         not a Grid: the tags are measured first and win the space, the parameters fill what
                                         is left and are the ones that trim when both do not fit. The pin sits in the same
                                         32-wide slot, with the same 3-point side margins, as the overflow button above it. -->
                                    <DockPanel Grid.Row="2" Margin="0,1,0,0" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" ToolTip="{DynamicResource PinTip}"
                                                AutomationProperties.Name="{DynamicResource PinName}" Tag="{Binding}" Click="PinButton_Click"
                                                Width="32" Height="22" Padding="0" Margin="3,0,3,0" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14">
                                                <Viewbox>
                                                    <Path Data="{StaticResource Icon.action.pin}" Width="24" Height="24" FlowDirection="LeftToRight"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Channel.Pinned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Viewbox>
                                                <Viewbox>
                                                    <Path Data="{StaticResource Icon.action.pin--off}" Width="24" Height="24" FlowDirection="LeftToRight"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Channel.Pinned}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Viewbox>
                                            </Grid>
                                        </Button>
                                        <!-- SP-0033: the metadata text keeps trimming while the region pill stays at its
                                             natural width and collapses to nothing when absent. -->
                                        <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Metadata}" Foreground="{DynamicResource InfoBrush}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Metadata}" />
                                            <Border Grid.Column="1" Margin="7,0,0,0" Padding="7,2" CornerRadius="9"
                                                    Background="{DynamicResource GeoHintBrush}" VerticalAlignment="Center"
                                                    Visibility="{Binding RegionRestrictedVisibility}"
                                                    ToolTip="{Binding RegionRestrictedTip}"
                                                    AutomationProperties.Name="{Binding RegionRestrictedLabel}">
                                                <TextBlock Text="{Binding RegionRestrictedLabel}" Foreground="{DynamicResource GeoTextBrush}" FontSize="10" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Margin="10,0,4,0" Text="{Binding TechnicalDetails}"
                                                   Visibility="{Binding TechnicalDetailsVisibility}" Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding TechnicalDetails}" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <!-- Out of theme (APP-STYLE 5, the content-coloured case): everything a tile draws
                             sits over its picture - title, kind, badges, the now-playing disc and the play,
                             stop and overflow plates - so each carries its own backing and white ink rather
                             than a themed text colour that would vanish over half the pictures. The status
                             dot is the exception on purpose: it takes the palette's status roles, so an
                             outcome reads as the same colour in the list and in the grid. -->
                        <DataTemplate x:Key="StreamGridTileTemplate">
                            <!-- SP-0067 considered removing this Viewbox as a per-tile measure pass and
                                 kept it deliberately. It is not decoration: the UniformGrid divides the
                                 row into equal columns whose width is the available width over the
                                 column count, while the Border below is a fixed GridTileWidth. The
                                 Viewbox is what absorbs the remainder and makes tiles meet edge to edge.
                                 Removing it leaves fixed-size tiles with a ragged gap at the row's end -
                                 a visible layout change, which this ticket's non-goals forbid. -->
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="3">
                                <Border x:Name="TileBorder" Width="{Binding DataContext.GridTileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.GridTileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource StreamGridTileBorderStyle}"
                                        CornerRadius="7" ClipToBounds="True"
                                        PreviewMouseLeftButtonDown="StreamCard_PreviewMouseLeftButtonDown"
                                        MouseEnter="StreamTile_MouseEnter" MouseLeave="StreamTile_MouseLeave"
                                        ToolTip="{Binding DisplayTitle}">
                                    <Grid>
                                        <!-- SP-0087: the same fallback as the list card, sized by the tile. Its visibility reads
                                             TileImage, so a captured preview frame wins over the monogram with no second rule. The
                                             Viewbox is what makes one markup serve every StreamTileSize. -->
                                        <!-- SP-0110 decision 1a: while the station plays, its picture steps back to a centred
                                             plate (below) and the backdrop fills the tile. The tile is dark in both themes, so
                                             its fixed background is the wash and the contract's dark values apply (rule 7). -->
                                        <local:WaveParticlesBackdrop Session="{Binding Backdrop}" Intent="Decorative" Intensity="0.55"
                                                                     WashBrush="{Binding Background, ElementName=TileBorder}" />
                                        <Border Background="{Binding MonogramBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="{Binding TileFallbackVisibility}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBackdrop}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Viewbox Grid.Row="0" Stretch="Uniform" Margin="8" MaxWidth="150" MaxHeight="120">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding MonogramText}" Foreground="{Binding MonogramForeground}"
                                                                   FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding CountryCode}" Foreground="{Binding MonogramForeground}"
                                                                   Visibility="{Binding CountryCodeVisibility}" Opacity="0.75"
                                                                   FontSize="16" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Viewbox>
                                                <!-- Reserves exactly the band the title scrim below occupies, so the monogram is
                                                     laid out above the title instead of behind it - at every tile size, because
                                                     the band is a fixed 70 while the tile is 67 to 225 tall. Collapsed by the same
                                                     IsVerySmallTile trigger the scrim itself uses, so the two can never disagree. -->
                                                <Border Grid.Row="1" Height="70">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Image Source="{Binding TileImage}" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBackdrop}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- SP-0110: the playing station's picture as a plate over the backdrop, laid out above
                                             the title band the same way the monogram fallback is. -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBackdrop}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Viewbox Grid.Row="0" Stretch="Uniform" Margin="10" MaxWidth="110" MaxHeight="110">
                                                <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True"
                                                        Background="{DynamicResource FaviconPlateBrush}">
                                                    <Grid>
                                                        <Border Background="{Binding MonogramBrush}" CornerRadius="8"
                                                                Visibility="{Binding TileFallbackVisibility}">
                                                            <TextBlock Text="{Binding MonogramText}" Foreground="{Binding MonogramForeground}"
                                                                       FontSize="26" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding TileImage}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                            </Viewbox>
                                            <Border Grid.Row="1" Height="70">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                        <Border VerticalAlignment="Bottom" Height="70">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Background>
                                                <StaticResource ResourceKey="TileScrimBrush" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Margin" Value="12,0,56,12" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Margin" Value="4,0,0,4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <!-- Now-playing indicator: spins while this station's audio plays; stops on stop/switch. -->
                                            <Grid VerticalAlignment="Bottom">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Width" Value="22" />
                                                        <Setter Property="Height" Value="22" />
                                                        <Setter Property="Margin" Value="0,0,8,2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Width" Value="12" />
                                                                <Setter Property="Height" Value="12" />
                                                                <Setter Property="Margin" Value="0" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Ellipse Fill="#CC2364AA" />
                                                <Path Data="{StaticResource Icon.content.audio}" FlowDirection="LeftToRight"
                                                      Fill="White" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="NoteRotateGrid" />
                                                    </Path.RenderTransform>
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Margin" Value="5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Margin" Value="2" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard Name="SpinNoteGrid">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0" To="360" Duration="0:0:1.8" RepeatBehavior="Forever" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="SpinNoteGrid" />
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontWeight="SemiBold"
                                                           FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}" />
                                                <TextBlock Text="{Binding KindLabel}" Foreground="#FFD4E2F2" FontSize="10" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                 ToolTip="{Binding StatusLabel}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDotStyle}">
                                                    <Setter Property="Margin" Value="12,0,0,47" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Margin" Value="4,0,0,4" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <!-- SP-0033: the pinned and region badges share one stack, so a region-locked
                                             channel that is not pinned rises to the top slot instead of leaving a gap,
                                             and a channel that is both never overlaps. -->
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border Padding="7,3" CornerRadius="9" Background="#D92364AA"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding PinnedVisibility}">
                                                <TextBlock Text="{DynamicResource Pinned}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Margin="0,4,0,0" Padding="7,3" CornerRadius="9" Background="#D9B36B00"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding RegionRestrictedVisibility}"
                                                    ToolTip="{Binding RegionRestrictedTip}"
                                                    AutomationProperties.Name="{Binding RegionRestrictedLabel}">
                                                <TextBlock Text="{Binding RegionRestrictedLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Content=""
                                                Width="34" Height="30" Padding="0" Background="#C8111827" Foreground="White"
                                                Tag="{Binding}" Click="OverflowButton_Click" ToolTip="{DynamicResource MoreActionsTip}"
                                                AutomationProperties.Name="{DynamicResource MoreActionsName}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MoreGlyphButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Content=""
                                                Width="38" Height="34" Padding="0" Background="#DD2364AA" Foreground="White"
                                                Tag="{Binding}" Click="PlayButton_Click" ToolTip="{DynamicResource PlayTip}"
                                                AutomationProperties.Name="{DynamicResource PlayTip}">
                                            <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PlayGlyphButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Content=""
                                                Width="38" Height="34" Padding="0" Background="#DD2364AA" Foreground="White"
                                                Tag="{Binding}" Click="PlayButton_Click" ToolTip="{DynamicResource StopTip}"
                                                AutomationProperties.Name="{DynamicResource StopTip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource StopGlyphButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsPlayingAudio}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Background="#D9111827" Padding="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                <Condition Binding="{Binding IsTileHovered}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding DataContext.IsVerySmallTile, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="14" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="25" />
                                                        <ColumnDefinition Width="38" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="7"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayTitle}" />
                                                    <Border Grid.Column="1" Padding="2,1" CornerRadius="3" Background="#D92364AA"
                                                            Visibility="{Binding PinnedVisibility}" ToolTip="{DynamicResource Pinned}">
                                                        <TextBlock Text="{DynamicResource Pinned}" Foreground="White" FontSize="5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <Border Grid.Column="2" Margin="1,0,0,0" Padding="2,1" CornerRadius="3" Background="#D9B36B00"
                                                            Visibility="{Binding RegionRestrictedVisibility}" ToolTip="{Binding RegionRestrictedTip}">
                                                        <TextBlock Text="{Binding RegionRestrictedLabel}" Foreground="White" FontSize="5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Button Style="{StaticResource MoreGlyphButton}" Content="" Width="17" Height="15" Padding="0"
                                                            Background="#C8111827" Foreground="White" Tag="{Binding}" Click="OverflowButton_Click"
                                                            ToolTip="{DynamicResource MoreActionsTip}" AutomationProperties.Name="{DynamicResource MoreActionsName}" />
                                                    <Button Content="" Width="19" Height="17" Padding="0"
                                                            Background="#DD2364AA" Foreground="White" Tag="{Binding}" Click="PlayButton_Click"
                                                            ToolTip="{DynamicResource PlayTip}" AutomationProperties.Name="{DynamicResource PlayTip}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource PlayGlyphButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="" Width="19" Height="17" Padding="0" Background="#DD2364AA" Foreground="White"
                                                            Tag="{Binding}" Click="PlayButton_Click" ToolTip="{DynamicResource StopTip}"
                                                            AutomationProperties.Name="{DynamicResource StopTip}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource StopGlyphButton}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </DataTemplate>
                </Grid.Resources>

                <Button Grid.Row="0" Style="{StaticResource SectionHeaderButtonStyle}"
                        Visibility="{Binding PinnedHeaderVisibility}" Click="PinnedHeader_Click"
                        AutomationProperties.Name="{DynamicResource PinnedSectionHeader}"
                        ToolTip="{DynamicResource CollapseSectionTip}">
                    <StackPanel Orientation="Horizontal">
                        <!-- SP-0113: nav.collapse while open, nav.expand while collapsed - the action a click takes. -->
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" FlowDirection="LeftToRight">
                        <Grid Width="24" Height="24">
                            <Path Data="{StaticResource Icon.nav.collapse}" Width="24" Height="24" Fill="{DynamicResource TextBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PinnedSectionCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.nav.expand}" Width="24" Height="24" Fill="{DynamicResource TextBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PinnedSectionCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource PinnedSectionHeader}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- SP-0067: two virtualized lists in one cell, one per view mode, replacing a
                     ScrollViewer around a non-virtualizing ItemsControl. Pinning is not capped, so this
                     is a second surface that has to cost its viewport rather than its content. Both
                     carry the shared container style so a pinned card is identical to a main-list one,
                     and both keep MouseDoubleClick, which is what launches a pinned channel. -->

                <!-- Tile mode: the same chunked-rows shape as the main list, so pinned and unpinned
                     tiles line up on the same column grid. -->
                <ListView Grid.Row="1" x:Name="PinnedGridList" ItemsSource="{Binding PinnedGridRows}"
                          Visibility="{Binding PinnedGridVisibility}" BorderThickness="0"
                          ItemContainerStyle="{StaticResource CatalogItemContainerStyle}"
                          Margin="3,0,3,4" Focusable="False"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.ScrollChanged="PinnedList_ScrollChanged"
                          MouseDoubleClick="StreamsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding ColumnCount}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource StreamGridTileTemplate}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- List mode: a fixed-height sideways strip. CanContentScroll must stay True or the
                     panel falls back to a plain scrolling surface and virtualizes nothing at all. -->
                <ListView Grid.Row="1" x:Name="PinnedStripList" ItemsSource="{Binding PinnedRows}"
                          Visibility="{Binding PinnedStripVisibility}" BorderThickness="0"
                          ItemContainerStyle="{StaticResource CatalogItemContainerStyle}"
                          Margin="3,0,3,4" Focusable="False"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="StreamsList_MouseDoubleClick">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" Width="326"
                                            ContentTemplate="{StaticResource StreamCardTemplate}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="2" Style="{StaticResource SectionHeaderButtonStyle}"
                        Visibility="{Binding MainHeaderVisibility}" Click="MainHeader_Click"
                        AutomationProperties.Name="{DynamicResource MainSectionHeader}"
                        ToolTip="{DynamicResource CollapseSectionTip}">
                    <StackPanel Orientation="Horizontal">
                        <!-- SP-0113: nav.collapse while open, nav.expand while collapsed - the action a click takes. -->
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" FlowDirection="LeftToRight">
                        <Grid Width="24" Height="24">
                            <Path Data="{StaticResource Icon.nav.collapse}" Width="24" Height="24" Fill="{DynamicResource TextBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MainSectionCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="{StaticResource Icon.nav.expand}" Width="24" Height="24" Fill="{DynamicResource TextBrush}">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MainSectionCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        </Viewbox>
                        <TextBlock Text="{DynamicResource MainSectionHeader}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Row="3" Visibility="{Binding MainContentVisibility}">
                    <!-- SP-0067: ScrollUnit="Pixel" - the panel stays a virtualizing stack panel and
                         stays virtualized, only the granularity changes. Scrolling by item moved a whole
                         grid row per wheel notch, which in tile mode is a jump of a full tile height. -->
                    <ListView x:Name="StreamsList" ItemsSource="{Binding GridRows}" BorderThickness="0"
                              ItemContainerStyle="{StaticResource CatalogItemContainerStyle}"
                              ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              SizeChanged="StreamsList_SizeChanged"
                              ScrollViewer.ScrollChanged="StreamsList_ScrollChanged" PreviewKeyDown="StreamsList_PreviewKeyDown"
                              MouseDoubleClick="StreamsList_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding ColumnCount}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource StreamCardTemplate}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsGridMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource StreamGridTileTemplate}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Illustration.empty-catalog}" Fill="{DynamicResource MutedBrush}" />
                    </Viewbox>
                    <TextBlock Text="{DynamicResource EmptyCatalog}" Margin="0,10" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" />
                    <!-- SP-0059: a WrapPanel, not a row. "Import channels from the internet" is a full
                         sentence in thirteen languages next to two other commands, and a row clips the
                         third button on a narrow window - which is the one the empty state must show. -->
                    <WrapPanel HorizontalAlignment="Center" MaxWidth="460">
                        <Button Style="{StaticResource AddGlyphButton}" Content="{DynamicResource AddStreamPlain}" Click="AddButton_Click" />
                        <!-- SP-0058: a first-time recipient has an empty catalog and never opens the
                             operations menu, so the paste command has to be reachable from here too. -->
                        <Button Style="{StaticResource AddGlyphButton}" Content="{DynamicResource PasteChannelPlain}" Click="PasteChannelButton_Click" />
                        <Button Style="{StaticResource RefreshGlyphButton}" Content="{DynamicResource UpdateCatalogPlain}" Click="RefreshButton_Click" />
                    </WrapPanel>
                </StackPanel>
                </Grid>
            </Grid>
            </DockPanel>
        </Border>

        <!-- SP-0102: Theme-adaptive bottom status bar instead of hardcoded #FF172236 -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- SP-0082: playback controls sit directly adjacent to the station title and now-playing
                     metadata on the leading side, rather than across the whole window. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- SP-0081: one button with two states - stop the sound of the current station, or
                         start it again. Its style and caption are assigned in code because they change
                         with the state; the XAML here only reserves the place. -->
                    <Button x:Name="AudioTransportButton" Style="{StaticResource StopGlyphButton}" Content="{DynamicResource StopAudio}"
                            Click="AudioTransportButton_Click" IsEnabled="False" Visibility="Collapsed" Margin="0,0,8,0" />
                    <Button x:Name="AudioRecordButton" Style="{StaticResource RecordGlyphOnlyButton}"
                            Click="AudioRecordButton_Click" Visibility="Collapsed" Margin="0,0,8,0"
                            ToolTip="{DynamicResource RecordTip}" AutomationProperties.Name="{DynamicResource Record}"
                            ToolTipService.ShowOnDisabled="True" />
                    <!-- IsMoveToPointEnabled: a click jumps the volume straight to the clicked level instead of stepping toward it. -->
                    <Slider x:Name="AudioVolumeSlider" Width="110" Minimum="0" Maximum="100" Value="100" TickFrequency="10"
                            IsMoveToPointEnabled="True"
                            ValueChanged="AudioVolumeSlider_ValueChanged" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            ToolTip="{DynamicResource AudioVolumeTip}" AutomationProperties.Name="{DynamicResource AudioVolumeName}" />
                    <!-- SP-0022: the sleep timer lives next to Stop, so it is one click away mid-listening. -->
                    <Button x:Name="SleepTimerButton" Style="{StaticResource SleepTimerGlyphButton}"
                            Click="SleepTimerButton_Click" Visibility="Collapsed"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource SleepTimerTip}" AutomationProperties.Name="{DynamicResource SleepTimer}">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SleepTimerMenu" />
                        </Button.ContextMenu>
                    </Button>
                    <!-- SP-0080: one action, next to the controls it takes with it. Glyph only - the bar
                         has no width left for a fifth caption, and the tooltip and the accessible name
                         carry the words. -->
                    <Button x:Name="CompactPanelButton" Style="{StaticResource PictureInPictureGlyphOnlyButton}"
                            Click="CompactPanelButton_Click" Visibility="Collapsed" Margin="0,0,12,0"
                            ToolTip="{DynamicResource CompactPanelTip}"
                            AutomationProperties.Name="{DynamicResource CompactPanelName}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- SP-0138: what is on air is the headline; the operation status is secondary and sits
                         below it, directly above the progress row it captions. -->
                    <TextBlock x:Name="NowPlayingText" Text="{DynamicResource NothingPlaying}" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Ready}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                    <!-- SP-0056: the bar and its cancel button share a row so the status area's height does
                         not shift when a cancellable download starts. Maximum is static; only IsIndeterminate
                         and Value move, and SetBusy restores the indeterminate default for the operations
                         that report nothing. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ProgressBar x:Name="CatalogProgress" Height="4" Margin="0,4,0,2" Width="180" VerticalAlignment="Center"
                                     Maximum="100" IsIndeterminate="True" Visibility="Collapsed"
                                     AutomationProperties.Name="{DynamicResource CatalogProgressName}" />
                        <Button x:Name="CancelOperationButton" Content="{DynamicResource Cancel}" Click="CancelOperationButton_Click"
                                Visibility="Collapsed" Margin="8,2,0,0" Padding="8,1" FontSize="11" VerticalAlignment="Center"
                                ToolTip="{DynamicResource CancelDownloadTip}"
                                AutomationProperties.Name="{DynamicResource CancelDownloadName}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
