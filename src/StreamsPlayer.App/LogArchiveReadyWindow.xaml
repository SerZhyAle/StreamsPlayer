<Window x:Class="StreamsPlayer.App.LogArchiveReadyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource SendLogs}"
        SizeToContent="WidthAndHeight" MinWidth="520" MaxWidth="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="18">
        <TextBlock Text="{DynamicResource LogArchiveReady}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="ArchivePathBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="54" Margin="0,8,0,0" Padding="7,5"
                 AutomationProperties.Name="{DynamicResource LogArchiveReady}" />
        <TextBlock Text="{DynamicResource SendLogsAttachHint}" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OpenFolderButton" Style="{StaticResource OpenFolderGlyphButton}" Content="{DynamicResource LogArchiveOpenFolder}"
                    Click="OpenFolder_Click" Padding="14,6" Margin="4,3" />
            <Button Style="{StaticResource CloseAnswerGlyphButton}" Content="{DynamicResource Close}" IsCancel="True" IsDefault="True" Margin="4,3" />
        </WrapPanel>
    </StackPanel>
</Window>
