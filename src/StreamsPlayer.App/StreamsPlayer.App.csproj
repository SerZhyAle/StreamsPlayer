<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StreamsPlayer.Core\StreamsPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!-- SP-0026: opt-in FlyleafLib video engine (LGPL-3.0). The managed library + FFmpeg bindings come
       from NuGet; the native FFmpeg v8 DLLs are NOT on NuGet and must be deployed separately (x64 only)
       into the FFmpeg folder resolved by FlyleafVideoBackend. LibVLC stays the default engine. -->
  <ItemGroup>
    <PackageReference Include="FlyleafLib" Version="3.10.4" />
    <PackageReference Include="Flyleaf.FFmpeg.Bindings" Version="8.0.1" />
  </ItemGroup>

  <!-- Ship one LibVLC native tree, not three. VideoLAN.LibVLC.Windows.targets keys its three
       copy switches off $(Platform), which is AnyCPU for a WPF project, so all of win-x64, win-x86 and
       win-arm64 land in the output regardless of the runtime being published. Only the tree matching
       the process architecture is ever loaded, so the other two were 84 MB of packed dead weight -
       about 40% of the MSIX. Key them off the runtime identifier instead. An empty RuntimeIdentifier
       (a plain `dotnet build`, and every test run) means the x64 development machine, so x64 stays on;
       build.ps1 still offers -Runtime win-arm64, which is why that branch is preserved rather than
       flattened away. -->
  <PropertyGroup>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-arm64'">false</VlcWindowsX64Enabled>
    <VlcWindowsArm64Enabled Condition="'$(RuntimeIdentifier)' != 'win-arm64'">false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows SDK version is required to project the WinRT System Media Transport Controls
         (SP-0021). SupportedOSPlatformVersion is kept lower so the app still runs on older
         Windows 10 builds; the SMTC APIs used have shipped since 10.0.10240. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>StreamsPlayer</AssemblyName>
    <ApplicationIcon Condition="Exists('..\..\assets\streamsplayer.ico')">..\..\assets\streamsplayer.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- SP-0073: enabled for exactly one member, FlyleafVideoBackend.ReadNowPlaying. FlyleafLib reads
         the stream's metadata once, in Demuxer.Open, and never refreshes it, so the "what is on air"
         line could not reach parity with the LibVLC engine through the library's managed surface. The
         supported route is the one FlyleafLib itself leaves public - the AVFormatContext pointer and the
         lock that guards it - which needs pointer syntax. Nothing else in this assembly uses it; keep it
         that way. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
