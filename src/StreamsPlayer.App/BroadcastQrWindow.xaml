<Window x:Class="StreamsPlayer.App.BroadcastQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource BroadcastQrTitle}" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="18" MaxWidth="420">
        <TextBlock Text="{DynamicResource BroadcastQrHint}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <!-- Out of theme (APP-STYLE 5, a picture's own plate): a QR code is dark modules on a light field whatever the
             theme, because a camera reads contrast and not colour names, so the white field is part of the picture. -->
        <Border Background="White" HorizontalAlignment="Center" Padding="0">
            <Image x:Name="QrImage" Width="320" Height="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"
                   AutomationProperties.Name="{DynamicResource BroadcastQrImageName}" />
        </Border>
        <TextBlock x:Name="TooLongText" Text="{DynamicResource BroadcastQrTooLong}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,12,0,0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource Close}" IsCancel="True" IsDefault="True" Margin="4,3" />
        </WrapPanel>
    </StackPanel>
</Window>
