<Window x:Class="StreamsPlayer.App.ExternalControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamsPlayer.App"
        Title="{DynamicResource RemoteControlTitle}" FlowDirection="{DynamicResource UiFlowDirection}"
        Width="720" Height="600" MinWidth="560" MinHeight="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button x:Name="HelpButton" DockPanel.Dock="Right" Style="{StaticResource HelpGlyphButton}"
                    ToolTip="{DynamicResource HelpTip}" AutomationProperties.Name="{DynamicResource HelpName}" />
            <TextBlock Text="{DynamicResource RemoteControlTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander Style="{StaticResource SettingsGroup}" IsExpanded="True" local:HelpAnchor.Id="e-remote-listening">
                    <Expander.Header><TextBlock Text="{DynamicResource RemoteThisDevice}" TextWrapping="Wrap" /></Expander.Header>
                    <StackPanel>
                        <local:BooleanOptionRow x:Name="RemoteListeningOption" local:HelpAnchor.Id="e-remote-listening" Caption="{DynamicResource RemoteListening}"
                                                Explanation="{DynamicResource RemoteListeningNote}" Toggled="Listening_Click" />
                        <TextBlock x:Name="StateText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="ListeningError" Text="{DynamicResource RemoteSaveFailed}" Visibility="Collapsed" TextWrapping="Wrap" />
                        <Button x:Name="ExchangeAction" Style="{StaticResource SettingsLinkButton}" Click="ExchangeAction_Click"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="ConsentSection" Style="{StaticResource SettingsGroup}" IsExpanded="True"
                          Visibility="Collapsed" local:HelpAnchor.Id="e-remote-consent">
                    <Expander.Header><TextBlock Text="{DynamicResource RemoteWaiting}" TextWrapping="Wrap" /></Expander.Header>
                    <StackPanel>
                        <TextBlock x:Name="ConsentTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConsentCommand" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConsentKind" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConsentCountdown" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="AllowButton" Style="{StaticResource ConfirmAnswerGlyphButton}" Content="{DynamicResource RemotePromptAllow}"
                                    Click="Allow_Click" Margin="0,0,8,0" />
                            <Button x:Name="DeclineButton" Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource RemotePromptDecline}"
                                    Click="Decline_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
                <Expander x:Name="ControllersSection" Style="{StaticResource SettingsGroup}" IsExpanded="True" local:HelpAnchor.Id="e-remote-controllers">
                    <Expander.Header><TextBlock Text="{DynamicResource RemoteControllersTitle}" TextWrapping="Wrap" /></Expander.Header>
                    <StackPanel>
                        <TextBlock x:Name="ControllersState" TextWrapping="Wrap" />
                        <StackPanel x:Name="ControllersList" />
                    </StackPanel>
                </Expander>
                <Expander x:Name="CommandsSection" Style="{StaticResource SettingsGroup}" local:HelpAnchor.Id="e-remote-commands">
                    <Expander.Header><TextBlock Text="{DynamicResource RemoteCommandsTitle}" TextWrapping="Wrap" /></Expander.Header>
                    <ItemsControl x:Name="CommandsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander x:Name="LogSection" Style="{StaticResource SettingsGroup}" IsExpanded="True" local:HelpAnchor.Id="e-remote-log">
                    <Expander.Header><TextBlock Text="{DynamicResource RemoteLogTitle}" TextWrapping="Wrap" /></Expander.Header>
                    <StackPanel>
                        <ItemsControl x:Name="RecentRequests">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="LogEmpty" Text="{DynamicResource RemoteLogEmpty}" TextWrapping="Wrap" />
                        <Button x:Name="OpenLogButton" Style="{StaticResource SettingsLinkButton}" Content="{DynamicResource RemoteOpenLog}"
                                Click="OpenLog_Click" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBox x:Name="FullLog" IsReadOnly="True" Visibility="Collapsed" MaxHeight="240"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{DynamicResource RemoteOpenLog}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="2" Style="{StaticResource CloseAnswerGlyphButton}" Content="{DynamicResource RemoteClose}"
                Click="Close_Click" HorizontalAlignment="Right" Margin="0,10,0,0" />
    </Grid>
</Window>
