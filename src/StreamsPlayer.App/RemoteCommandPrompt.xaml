<Window x:Class="StreamsPlayer.App.RemoteCommandPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True" ShowActivated="False"
        Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="KindText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="CountdownText" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AllowButton" Style="{StaticResource ConfirmAnswerGlyphButton}" Content="{DynamicResource RemotePromptAllow}" Click="Allow_Click" Margin="4,3" />
            <Button x:Name="DeclineButton" Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource RemotePromptDecline}" Click="Decline_Click"
                    IsDefault="True" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
