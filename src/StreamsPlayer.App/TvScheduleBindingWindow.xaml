<Window x:Class="StreamsPlayer.App.TvScheduleBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource TvScheduleBindingTitle}"
        Width="520" SizeToContent="Height" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <!-- SP-0075: binds one catalog channel to a schedule channel by hand. Cancel is the one exit that changes
         nothing (APP-BEHAVIOUR rule 1); each of the other three buttons commits exactly what it names. -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="SearchBox" Grid.Row="1" Padding="6,4" TextChanged="SearchBox_TextChanged"
                 AutomationProperties.Name="{DynamicResource TvScheduleBindingSearch}"
                 ToolTip="{DynamicResource TvScheduleBindingSearch}" />
        <!-- Background stated: a ListBox without one keeps WPF's white default while its items take the
             theme's light text brush, which is unreadable in the dark theme (same trap as Settings' list). -->
        <ListBox x:Name="ChannelList" Grid.Row="2" Height="260" Margin="0,8,0,0"
                 Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 DisplayMemberPath="Label" SelectionChanged="ChannelList_SelectionChanged"
                 MouseDoubleClick="ChannelList_MouseDoubleClick"
                 AutomationProperties.Name="{DynamicResource TvScheduleBindingTitle}" />
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource TvScheduleBindingAutomatic}" Click="Automatic_Click"
                    Padding="12,6" Margin="0,0,8,0" ToolTip="{DynamicResource TvScheduleBindingAutomaticTip}" />
            <Button Content="{DynamicResource TvScheduleBindingNone}" Click="None_Click"
                    Padding="12,6" Margin="0,0,8,0" ToolTip="{DynamicResource TvScheduleBindingNoneTip}" />
            <Button x:Name="BindButton" Content="{DynamicResource TvScheduleBindingApply}" Click="Bind_Click"
                    IsDefault="True" IsEnabled="False" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="14,6" />
        </WrapPanel>
    </Grid>
</Window>
