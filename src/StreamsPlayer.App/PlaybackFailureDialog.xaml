<Window x:Class="StreamsPlayer.App.PlaybackFailureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource StreamUnavailableTitle}" SizeToContent="Height" MinHeight="180" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Top" />
        <!-- SP-0041: shown only when the channel was never reached because there was no network, so the
             dialog explains why it offers no hide/delete. SizeToContent grows the window for it. -->
        <TextBlock x:Name="NoNetworkText" Grid.Row="1" TextWrapping="Wrap" Visibility="Collapsed"
                   Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"
                   Text="{DynamicResource FailureNoNetwork}" />
        <!-- SP-0033: shown only for a channel the catalog tagged region-locked, so an ordinary failure
             dialog is unchanged. SizeToContent grows the window for this text instead of clipping it. -->
        <TextBlock x:Name="RegionRestrictedText" Grid.Row="2" TextWrapping="Wrap" Visibility="Collapsed"
                   Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"
                   Text="{DynamicResource FailureRegionRestricted}" />
        <TextBlock x:Name="CopiedText" Grid.Row="3" Visibility="Collapsed" Margin="0,10,0,0"
                   Foreground="{DynamicResource AccentMarkBrush}" Text="{DynamicResource FailureReportCopied}" />
        <!-- SP-0218: one row of whole buttons that wraps rather than clips (WINDOWS-UI 0.4 section 11 item 3).
             Retry is the affirmative answer and holds the default; Remove is "Hide" (reversible, mono) or
             "Delete" (the danger face) - the code-behind picks the style with the caption; Keep is the
             dismissing answer and, because a Delete may stand beside it, never takes the tint, so the only
             red face in the window is the one that cannot be undone (item 7). -->
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RetryButton" Style="{StaticResource ReconnectAnswerGlyphButton}" Content="{DynamicResource FailureRetry}" Click="Retry_Click" IsDefault="True" Margin="4,3" />
            <Button x:Name="CopyButton" Style="{StaticResource CopyGlyphButton}" Content="{DynamicResource FailureCopyReport}" Click="CopyReport_Click" Margin="4,3" Padding="14,6" />
            <Button x:Name="RemoveButton" Style="{StaticResource HiddenGlyphButton}" Content="{DynamicResource FailureDelete}" Click="Remove_Click" Margin="4,3" Padding="14,6" />
            <Button x:Name="KeepButton" Style="{StaticResource CancelUntintedAnswerGlyphButton}" Content="{DynamicResource FailureKeep}" Click="Keep_Click" IsCancel="True" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
