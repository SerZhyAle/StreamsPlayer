<Window x:Class="StreamsPlayer.App.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource LanguagePickerName}" Height="420" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            A ListBox rather than thirteen checkable menu items: arrow keys, Home/End, PageUp/PageDown
            and type-to-select all come for free, which is what criterion 7 means by keyboard-navigable.
            Each row is named in its own language, so the list is usable by someone who cannot read the
            other twelve.
        -->
        <ListBox x:Name="LanguageList" SelectionMode="Single"
                 MouseDoubleClick="LanguageList_MouseDoubleClick" KeyDown="LanguageList_KeyDown"
                 AutomationProperties.Name="{DynamicResource LanguagePickerName}"
                 HorizontalContentAlignment="Stretch" Padding="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Endonym}" FontSize="15" VerticalAlignment="Center" />
                        <!-- A check mark rather than a localized word: it needs no translation, so the
                             picker adds no key to thirteen dictionaries, and it survives a screenshot
                             and a high-contrast theme. Screen readers learn which entry is active from
                             the selection pattern - the active language is selected when the dialog
                             opens - so nothing is lost by the marker being a symbol. -->
                        <TextBlock Grid.Column="1" Text="&#x2713;"
                                   Visibility="{Binding ActiveMarkerVisibility}"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   Margin="8,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="{DynamicResource MachineTranslationNotice}" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,10,2,0" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="{DynamicResource Save}" Click="Confirm_Click"
                    IsDefault="True" Padding="16,6" Margin="8,0" />
            <Button Content="{DynamicResource Cancel}" IsCancel="True" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
