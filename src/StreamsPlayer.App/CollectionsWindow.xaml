<Window x:Class="StreamsPlayer.App.CollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource CollectionManageTitle}" Height="420" Width="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="NewNameBox" Width="240" Padding="7,4" VerticalAlignment="Center"
                     AutomationProperties.Name="{DynamicResource CollectionNew}" />
            <Button x:Name="CreateButton" Style="{StaticResource AddGlyphButton}" Content="{DynamicResource CollectionCreate}"
                    Click="Create_Click" />
        </StackPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{DynamicResource CollectionsEmpty}" Visibility="Collapsed"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" />
        <ListBox x:Name="CollectionList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding}" KeyDown="Rename_KeyDown" LostFocus="Rename_LostFocus"
                                     Padding="6,3" AutomationProperties.Name="{DynamicResource CollectionRename}" />
                            <TextBlock Text="{Binding CountText}" Opacity="0.65" Margin="2,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource TrashGlyphButton}" Content="{DynamicResource CollectionDelete}"
                                Tag="{Binding}" Click="Delete_Click" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Close}" IsCancel="True" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
