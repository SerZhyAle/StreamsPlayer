<Window x:Class="StreamsPlayer.App.BroadcastAudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Width="420" MinWidth="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <TextBlock x:Name="StateText" Opacity="0.7" TextWrapping="Wrap" />
            <Expander x:Name="FailureDetails" Header="{DynamicResource ExchangeDiagnosisDetails}" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock x:Name="FailureCode" TextWrapping="Wrap" />
            </Expander>
        </StackPanel>
        <!-- IsMoveToPointEnabled: a click jumps the volume straight to the clicked level instead of stepping toward it. -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsMoveToPointEnabled="True"
                    VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                    ToolTip="{DynamicResource AudioVolumeTip}" AutomationProperties.Name="{DynamicResource AudioVolumeName}" />
            <CheckBox x:Name="MuteBox" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                      Content="{DynamicResource Mute}" Checked="MuteBox_Changed" Unchecked="MuteBox_Changed" />
        </Grid>
        <TextBlock x:Name="RecordingText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RecordButton" Style="{StaticResource RecordGlyphOnlyButton}"
                    ToolTip="{DynamicResource RecordTip}" AutomationProperties.Name="{DynamicResource Record}"
                    Click="Record_Click" Margin="4,3" />
            <Button x:Name="PlayButton" Style="{StaticResource PlayGlyphButton}" Content="{DynamicResource Play}"
                    Click="Play_Click" Margin="4,3" Visibility="Collapsed" />
            <Button x:Name="DiagnoseButton" Style="{StaticResource SettingsGlyphButton}" Content="{DynamicResource ExchangeDiagnose}"
                    Click="Diagnose_Click" Margin="4,3" Visibility="Collapsed" />
            <Button x:Name="StopButton" Style="{StaticResource StopGlyphButton}" Content="{DynamicResource Stop}"
                    Click="Stop_Click" Margin="4,3" />
            <Button Style="{StaticResource CloseAnswerGlyphButton}" Content="{DynamicResource Close}" Click="Close_Click" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
