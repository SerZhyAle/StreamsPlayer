<Window x:Class="StreamsPlayer.App.ExchangeDiagnosisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource ExchangeDiagnosisTitle}" Width="560"
        SizeToContent="Height" MinHeight="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
    <StackPanel Margin="18">
        <!-- Two parts, in this order (DEVICE-EXCHANGE item DA): what happened, then what to try. -->
        <TextBlock Text="{DynamicResource ExchangeDiagnosisHappened}" FontWeight="SemiBold" Opacity="0.7" />
        <TextBlock x:Name="HappenedText" TextWrapping="Wrap" Margin="0,2,0,12" />
        <StackPanel x:Name="TryPanel" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource ExchangeDiagnosisTry}" FontWeight="SemiBold" Opacity="0.7" />
            <TextBlock x:Name="TryText" TextWrapping="Wrap" Margin="0,2,0,12" />
        </StackPanel>
        <ProgressBar x:Name="RunningBar" IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                     AutomationProperties.Name="{DynamicResource ExchangeDiagnosisRunning}" />
        <TextBlock x:Name="RunningText" Text="{DynamicResource ExchangeDiagnosisRunning}" Opacity="0.7" Margin="0,0,0,8" />
        <!-- The plumbing stays behind this control: the address, the code and the steps with their states. -->
        <Expander x:Name="DetailsExpander" Header="{DynamicResource ExchangeDiagnosisDetails}" Margin="0,4,0,0"
                  AutomationProperties.Name="{DynamicResource ExchangeDiagnosisDetails}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock x:Name="ServerText" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                <TextBlock x:Name="CodeText" TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,2,0,8" />
                <TextBlock x:Name="StepsHeading" Text="{DynamicResource ExchangeDiagnosisSteps}" FontWeight="SemiBold" Opacity="0.7" />
                <ItemsControl x:Name="StepList" Margin="0,2,0,0" Focusable="False"
                              AutomationProperties.Name="{DynamicResource ExchangeDiagnosisSteps}" />
            </StackPanel>
        </Expander>
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SettingsLinkButton}" Content="{DynamicResource MediaExchange}" Click="ExchangeHelp_Click"
                    ToolTip="{DynamicResource MediaExchangeTip}" AutomationProperties.Name="{DynamicResource MediaExchange}" Margin="4,3" />
            <Button x:Name="NextButton" Style="{StaticResource SettingsGlyphButton}" Content="{DynamicResource ExchangeDiagnosisNext}"
                    Click="Next_Click" Margin="4,3" Visibility="Collapsed" />
            <Button x:Name="AgainButton" Style="{StaticResource RefreshGlyphButton}" Content="{DynamicResource ExchangeDiagnosisAgain}"
                    Click="Again_Click" Margin="4,3" />
            <Button x:Name="CloseButton" Style="{StaticResource CloseAnswerGlyphButton}" Content="{DynamicResource Close}"
                    Click="Close_Click" IsCancel="True" IsDefault="True" Margin="4,3" />
        </WrapPanel>
    </StackPanel>
</Window>
