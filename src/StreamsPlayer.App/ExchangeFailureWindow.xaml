<Window x:Class="StreamsPlayer.App.ExchangeFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ExchangeTitle}" FlowDirection="{DynamicResource UiFlowDirection}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="HappenedText" TextWrapping="Wrap" />
        <TextBlock x:Name="TryText" TextWrapping="Wrap" Margin="0,10,0,0" />
        <Expander Header="{DynamicResource ExchangeDiagnosisDetails}" Margin="0,14,0,0">
            <TextBlock x:Name="CodeText" TextWrapping="Wrap" />
        </Expander>
        <Button Content="{DynamicResource Close}" Style="{StaticResource CloseAnswerGlyphButton}" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click" />
    </StackPanel>
</Window>
