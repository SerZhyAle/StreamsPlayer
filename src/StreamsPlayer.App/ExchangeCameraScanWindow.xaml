<Window x:Class="StreamsPlayer.App.ExchangeCameraScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource ExchangeCameraTitle}" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource ExchangeCameraHold}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <!-- SP-0229 requirement 2: said before the picture runs and while it does - the picture is looked at here and goes nowhere. -->
        <TextBlock Grid.Row="1" Text="{DynamicResource ExchangeCameraPrivacy}" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <!-- Only with two or more cameras: a virtual camera listed first must not be a dead end. -->
        <Grid x:Name="ChooserRow" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource ExchangeCameraChoose}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CameraBox" Grid.Column="1" DisplayMemberPath="Name" Padding="6,4"
                      AutomationProperties.Name="{DynamicResource ExchangeCameraChoose}" SelectionChanged="Camera_SelectionChanged" />
        </Grid>
        <!-- A picture of the world is not mirrored by a right-to-left interface. -->
        <Image x:Name="Preview" Grid.Row="3" Stretch="Uniform" FlowDirection="LeftToRight"
               AutomationProperties.Name="{DynamicResource ExchangeCameraTitle}" />
        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" MinHeight="40" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource Cancel}"
                    Click="Cancel_Click" IsCancel="True" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
