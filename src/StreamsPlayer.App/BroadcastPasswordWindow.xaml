<Window x:Class="StreamsPlayer.App.BroadcastPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource BroadcastPasswordTitle}" Height="230" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Padding="6,4" />
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SettingsLinkButton}" Content="{DynamicResource MediaExchange}" Click="ExchangeHelp_Click"
                    ToolTip="{DynamicResource MediaExchangeTip}" AutomationProperties.Name="{DynamicResource MediaExchange}" Margin="4,3" />
            <Button x:Name="ConfirmButton" Style="{StaticResource ImportAnswerGlyphButton}" Content="{DynamicResource Play}" Click="Confirm_Click"
                    IsDefault="True" Margin="4,3" />
            <Button Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource Cancel}" IsCancel="True" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
