<Window x:Class="StreamsPlayer.App.ExchangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StreamsPlayer.App"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource ExchangePasswordTitle}" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <!-- The rule is stated before the person types, not after a refusal (SP-0221 requirement 5). -->
        <!-- SP-0234, EXCHANGE-MARK rule 8a: the dialog that manages the account wears the mark at its head, beside the rule. -->
        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <local:ExchangeMarkIcon DipSize="24" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0" />
            <TextBlock Text="{DynamicResource ExchangePasswordRule}" TextWrapping="Wrap" />
        </DockPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource ExchangePasswordOld}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <PasswordBox x:Name="OldBox" Grid.Row="1" Grid.Column="1" Padding="6,4" Margin="0,0,0,8"
                     AutomationProperties.Name="{DynamicResource ExchangePasswordOld}" />
        <TextBlock Grid.Row="2" Text="{DynamicResource ExchangePasswordNew}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <PasswordBox x:Name="NewBox" Grid.Row="2" Grid.Column="1" Padding="6,4" Margin="0,0,0,8"
                     AutomationProperties.Name="{DynamicResource ExchangePasswordNew}" />
        <TextBlock Grid.Row="3" Text="{DynamicResource ExchangePasswordNewAgain}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <PasswordBox x:Name="AgainBox" Grid.Row="3" Grid.Column="1" Padding="6,4" Margin="0,0,0,8"
                     AutomationProperties.Name="{DynamicResource ExchangePasswordNewAgain}" />
        <ProgressBar x:Name="WaitingBar" Grid.Row="4" Grid.ColumnSpan="2" IsIndeterminate="True" Height="4" Margin="0,4,0,8"
                     Visibility="Collapsed" AutomationProperties.Name="{DynamicResource ExchangePasswordWaiting}" />
        <TextBlock x:Name="StatusText" Grid.Row="5" Grid.ColumnSpan="2" TextWrapping="Wrap" />
        <WrapPanel Grid.Row="6" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SettingsLinkButton}" Content="{DynamicResource MediaExchange}" Click="ExchangeHelp_Click"
                    ToolTip="{DynamicResource MediaExchangeTip}" AutomationProperties.Name="{DynamicResource MediaExchange}" Margin="4,3" />
            <Button x:Name="ConfirmButton" Style="{StaticResource ConfirmAnswerGlyphButton}" Content="{DynamicResource Save}"
                    Click="Confirm_Click" IsDefault="True" Margin="4,3" />
            <Button x:Name="CancelButton" Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource Cancel}"
                    Click="Cancel_Click" IsCancel="True" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
