<Application x:Class="StreamsPlayer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamsPlayer.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Localization.en.xaml" />
                <!-- SP-0113: every glyph geometry, generated from Glyphs.map.json by tools/Sync-IconGlyphs.ps1. -->
                <ResourceDictionary Source="Glyphs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WindowBackground" Color="#FFF5F7FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
            <SolidColorBrush x:Key="TextBrush" Color="#FF172236" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF2364AA" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="White" />
            <SolidColorBrush x:Key="AccentMarkBrush" Color="#FF2364AA" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#FF2364AA" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF637083" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FFD5DCE6" />
            <SolidColorBrush x:Key="ControlBrush" Color="White" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFEFF6FF" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFD4E2F2" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="CardSelectedBrush" Color="#FFE8F1FA" />
            <SolidColorBrush x:Key="SectionBrush" Color="#FFEEF2F7" />
            <SolidColorBrush x:Key="FaviconPlateBrush" Color="#FFF0F2F5" />
            <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF8A96A8" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF386C8D" />
            <SolidColorBrush x:Key="GeoHintBrush" Color="#22B36B00" />
            <SolidColorBrush x:Key="GeoTextBrush" Color="#FF8A5300" />
            <SolidColorBrush x:Key="LinkBrush" Color="#FF0067C0" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF1E7E34" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFB07A00" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFB22222" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style TargetType="Control">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <!-- SP-0162: the keyboard focus position. The platform's own visual is a black dotted rectangle,
                 which on the dark theme's near-black surfaces cannot be seen, so every focusable control names
                 one of these two rings instead. The outer one sits just outside the control, for a button or
                 a box that has room around it; the inset one sits inside the edge, for an item in a list or a
                 tab strip, where an outer ring would be clipped by the list's own bounds or overdraw the
                 neighbour. Both draw from AccentMarkBrush, the accent in the form that reads on either theme. -->
            <Style x:Key="ThemedFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="-2" RadiusX="5" RadiusY="5" StrokeThickness="2" SnapsToDevicePixels="True"
                                       IsHitTestVisible="False" Stroke="{DynamicResource AccentMarkBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ThemedFocusVisualInset">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Rectangle Margin="1" RadiusX="3" RadiusY="3" StrokeThickness="2" SnapsToDevicePixels="True"
                                       IsHitTestVisible="False" Stroke="{DynamicResource AccentMarkBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Out of theme (APP-STYLE 5): the ring of a control drawn over live video, which decides its
                 own contrast (see PlayerOverlayButton). A white ring disappears over a bright frame and a dark
                 one over a dark frame, so it is both: a white ring with a near-black one outside it. -->
            <Style x:Key="PlayerOverlayFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid IsHitTestVisible="False">
                                <Rectangle Margin="-4" RadiusX="6" RadiusY="6" StrokeThickness="2" Stroke="#FF141A24" />
                                <Rectangle Margin="-2" RadiusX="5" RadiusY="5" StrokeThickness="2" Stroke="White" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Hyperlink">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}" />
            </Style>
            <!-- The Foreground setter is not decoration. Every glyph template below paints its Path from
                 the button's own Foreground, and without a setter that property is only inherited - from
                 a Window that has none, so it resolves to the system's black. In the dark theme that put
                 black glyphs on a near-black ControlBrush. The implicit Control style above does not
                 cover this: an implicit style matches the exact type, never a derived one. -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Border>
                            <!-- A text box draws no focus rectangle (its caret is the platform's cue), and a
                                 caret blinking in a near-black box is the only thing left in the dark theme. -->
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <!-- A Grid, not a horizontal StackPanel: a stack measures its children with
                             infinite width, so a wrapping label never learns how much room it has and
                             is clipped instead of wrapped. The star column hands the label the width
                             that is actually left. -->
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder" Width="15" Height="15" Margin="0,0,6,0"
                                        VerticalAlignment="Center" Background="{DynamicResource ControlBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2">
                                    <Path x:Name="CheckMark" Data="{StaticResource Chrome.check-box}" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Checked fills the box with the accent and draws the mark in the
                                     on-accent colour: an accent stroke on ControlBrush is invisible in the
                                     dark theme, where the two are both dark blue. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
                                    <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                    <Setter TargetName="CheckBorder" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisualInset}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="1">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisualInset}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <!-- SP-0162: the scrolling host the stock template has and this one had dropped. The
                                     popup hands its content the screen's height at most, so a menu with more
                                     entries than fit (one per collection) scrolls instead of running off it. -->
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="CheckMark" Data="{StaticResource Chrome.menu-check}" Stroke="{DynamicResource AccentMarkBrush}"
                                              StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed" VerticalAlignment="Center" />
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                          VerticalAlignment="Center" />
                                        <Path x:Name="SubmenuArrow" Grid.Column="2" Data="{StaticResource Chrome.submenu}" Stroke="{DynamicResource MutedBrush}"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" Padding="3" CornerRadius="6">
                                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="True" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- SP-0050: the catalog refresh keeps the accent it had as a header button now that it lives
                 in the operations menu. A style, not local values on the item: a local Background would
                 outrank the base style's hover trigger. The template's own trigger repaints the row with
                 ControlHoverBrush on hover, so the foreground has to come back off white there or the
                 highlighted entry would be white on near-white. -->
            <Style x:Key="AccentMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisualInset}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentMarkBrush}" />
                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,3,0" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Style>
            <!-- SP-0115: the scrollbar is templated here, not only coloured. The stock Aero2 template paints
                 its thumb and arrows from its own fixed light-grey brushes, which ignore Background and
                 Foreground, so the theme reached the track and nothing on it. Every part below draws from
                 the palette: the track from Background, the thumb and the arrows from MutedBrush - the
                 thumb at partial opacity, rising on hover and while dragged. -->

            <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollBarLineButton" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="LineButtonBorder" Background="Transparent">
                                <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="LineButtonBorder" Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollBarThumb" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBorder" Margin="{TemplateBinding Padding}" CornerRadius="3" Opacity="0.5"
                                    Background="{DynamicResource MutedBrush}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.RowDefinitions>
                        <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                        <RowDefinition Height="0.00001*" />
                        <RowDefinition MaxHeight="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}" />
                    </Grid.RowDefinitions>
                    <RepeatButton Grid.Row="0" Style="{StaticResource ScrollBarLineButton}"
                                  Command="ScrollBar.LineUpCommand" Content="{StaticResource Chrome.scroll-up}" />
                    <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollBarThumb}" Padding="3,1" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                    <RepeatButton Grid.Row="2" Style="{StaticResource ScrollBarLineButton}"
                                  Command="ScrollBar.LineDownCommand" Content="{StaticResource Chrome.scroll-down}" />
                </Grid>
            </ControlTemplate>
            <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                        <ColumnDefinition Width="0.00001*" />
                        <ColumnDefinition MaxWidth="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}" />
                    </Grid.ColumnDefinitions>
                    <RepeatButton Grid.Column="0" Style="{StaticResource ScrollBarLineButton}"
                                  Command="ScrollBar.LineLeftCommand" Content="{StaticResource Chrome.scroll-left}" />
                    <Track x:Name="PART_Track" Grid.Column="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollBarThumb}" Padding="1,3" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollBarLineButton}"
                                  Command="ScrollBar.LineRightCommand" Content="{StaticResource Chrome.scroll-right}" />
                </Grid>
            </ControlTemplate>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                <Setter Property="MinWidth" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" />
                        <Setter Property="MinHeight" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" />
                        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            </Style>
            <!-- SP-0114: the caption is a TextBlock bound to the button's own Foreground, like the glyph
                 beside it. A ContentPresenter here generated a TextBlock that the implicit TextBlock style
                 repainted in the theme's text colour, so an accent button's ink (AccentTextBrush) reached
                 the glyph and never the caption - see ButtonOwnColourCaption below for the mechanism. -->
            <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <Path Data="{Binding (local:Glyph.Geometry), RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <Path Data="{Binding (local:Glyph.Geometry), RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Viewbox>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The caption of a button whose Foreground is chosen for the surface it sits on - a dark
                 status bar, live video - rather than inherited from the theme. A string handed to a
                 ContentPresenter is drawn by a TextBlock the presenter generates, and the implicit
                 TextBlock style above beats the Foreground that TextBlock would otherwise inherit from
                 the button: the caption came out in the theme's text colour however the button was
                 painted. Binding the colour as a local value is what wins that contest. -->
            <DataTemplate x:Key="ButtonOwnColourCaption">
                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </DataTemplate>
            <!-- Out of theme (APP-STYLE 5), and every style based on this one with it.
                 The player's buttons are drawn over live video, so nothing about their legibility may
                 depend on the frame behind them or on the interface theme. Three things follow, and each
                 is here because leaving it out was visibly wrong:
                 * The fill is opaque. A translucent wash reads over a dark frame and disappears over a
                   bright one, and the player has no say in which frame it gets.
                 * Every caption and glyph carries its colour as a local value - see
                   ButtonOwnColourCaption above for why inheriting it is not enough.
                 * Hover and pressed are restated. Inherited from the interface's Button style they are
                   near-white brushes, and white text vanishes into them.
                 This style is the one home for all three; the glyph variants below add only a shape. -->
            <Style x:Key="PlayerOverlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#FF141A24" />
                <Setter Property="BorderBrush" Value="#FF7E8B9E" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerOverlayFocusVisual}" />
                <Setter Property="ContentTemplate" Value="{StaticResource ButtonOwnColourCaption}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF27303D" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF39445A" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PlayerOverlayGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <Path Data="{Binding (local:Glyph.Geometry), RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- SP-0113: the live player controls show the action a click performs (ICON-RENDER 4), so
                 mute and fullscreen each swap glyph with their caption: PlayerWindow assigns the pair. -->
            <Style x:Key="PlayerOverlayMuteGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.mute}" />
            </Style>
            <Style x:Key="PlayerOverlayUnmuteGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.volume}" />
            </Style>
            <!-- SP-0038: the glyph carries the whole meaning, so this one overlay button drops its
                 caption; its tooltip still names the action, as every player button does. -->
            <Style x:Key="PlayerOverlayGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <Path Data="{Binding (local:Glyph.Geometry), RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Viewbox>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PlayerOverlaySaveFrameGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphOnlyButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.media.capture-frame}" />
            </Style>
            <Style x:Key="PlayerOverlayRecordGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphOnlyButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.media.record}" />
            </Style>
            <Style x:Key="PlayerOverlayStopRecordGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphOnlyButton}">
                <Setter Property="Foreground" Value="#FFFF4D4D" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.stop}" />
            </Style>
            <Style x:Key="PlayerOverlayFullscreenGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.fullscreen}" />
            </Style>
            <Style x:Key="PlayerOverlayExitFullscreenGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.exit-fullscreen}" />
            </Style>
            <Style x:Key="PlayerOverlayCloseGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.nav.close}" />
            </Style>

            <Style x:Key="PlayerOverlayActionsGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphOnlyButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.nav.more}" />
            </Style>
            <!-- Out of theme (APP-STYLE 5): it sits on the player's own dark panel over video, and its
                 state colours come from SignalHealthAppearance, which says why.
                 SP-0045: the player's signal-health stripe. The stock ProgressBar template is replaced
                 rather than recoloured for two reasons: its animated glow repaints continuously over a
                 native video surface for no informational gain, and its track is not reliably driven by
                 Background - which this indicator needs, because the track is what carries the colour
                 when the buffer is empty and the fill has no width to carry it (decision 3). Both
                 brushes are assigned per state from code; the values here are only the neutral start. -->
            <Style x:Key="SignalHealthStripe" TargetType="ProgressBar">
                <Setter Property="Background" Value="#FF3A414D" />
                <Setter Property="Foreground" Value="#FF8A94A6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                                <Grid ClipToBounds="True">
                                    <!-- PART_Track is required by ProgressBar's own layout code even though it
                                         draws nothing here; the track colour is the Border above. -->
                                    <Rectangle x:Name="PART_Track" />
                                    <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                               Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ListGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.view.list}" />
            </Style>
            <Style x:Key="GridGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.view.grid}" />
            </Style>
            <Style x:Key="RefreshGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.refresh}" />
            </Style>
            <Style x:Key="AddGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.add}" />
            </Style>
            <Style x:Key="ImportGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.import}" />
            </Style>
            <Style x:Key="ExportGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.export}" />
            </Style>
            <Style x:Key="DeleteGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.delete}" />
            </Style>
            <!-- SP-0022, SP-0113: media.sleep-timer - the crescent moon with a small z. -->
            <Style x:Key="SleepTimerGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.sleep-timer}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <!-- SP-0022: the clock alone names the control - the caption beside it is the
                                 running countdown and nothing else, so it is absent (and takes no width)
                                 whenever no timer is set. The colour is bound rather than inherited
                                 because this button sits on the dark status bar: the implicit TextBlock
                                 style would otherwise repaint the countdown in the theme's text colour,
                                 which is the bar's own near-black. -->
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                    <Path Data="{Binding (local:Glyph.Geometry), RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="7,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.app.settings}" />
            </Style>
            <Style x:Key="HiddenGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.source.hidden}" />
            </Style>
            <Style x:Key="ClearInputGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.clear-input}" />
            </Style>
            <Style x:Key="ClearFilterGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.clear-filter}" />
            </Style>
            <!-- SP-0113: nav.open-external is `rtl: mirror` - the arrow leaves the square towards the
                 reading direction - so this template is the one that does not pin the glyph left-to-right. -->
            <Style x:Key="OpenFolderGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{Binding (local:Glyph.Geometry), RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.nav.open-external}" />
            </Style>
            <!-- SP-0050: the operations menu carries a word next to its glyph, so the three dots stay a
                 hint rather than the only thing distinguishing it from the gear beside it. -->
            <Style x:Key="OperationsGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.nav.more}" />
            </Style>
            <Style x:Key="FilterGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.filter}" />
            </Style>
            <!-- SP-0094: the two quick media buttons in the title line. Pressed and unpressed have to be
                 told apart across a room, so the trio swings the whole plate - a muted glyph on the
                 ordinary control fill when off, an accent fill with its own foreground when on - rather
                 than tinting the glyph alone. The Tag trigger is declared here, in the derived style, so
                 it outranks the base style's IsMouseOver background and a pressed button keeps its accent
                 while the pointer is over it. MainWindow.FilterPanel.cs drives the Tag; it is never set
                 in markup, because the value it reflects is the Media facet and nothing else. -->
            <Style x:Key="QuickMediaFilterButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="Padding" Value="8,6" />
                <!-- SP-0113: MutedBrush at full opacity. The disabled-text colour at 0.75 opacity this
                     replaced measured under the 3:1 a glyph needs (ICON-RENDER 3) on the light theme. -->
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- SP-0113: content.video, content.audio and (pending) the own-channels mark. -->
            <Style x:Key="QuickVideoFilterButton" TargetType="Button" BasedOn="{StaticResource QuickMediaFilterButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.content.video}" />
            </Style>

            <Style x:Key="QuickAudioFilterButton" TargetType="Button" BasedOn="{StaticResource QuickMediaFilterButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.content.audio}" />
            </Style>
            <!-- SP-0100: "the channels I brought", added by hand or imported. Pending in the vocabulary
                 (Glyphs.map.json), so it keeps this product's drawing until the owner decides. -->
            <Style x:Key="QuickOwnFilterButton" TargetType="Button" BasedOn="{StaticResource QuickMediaFilterButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.source.own}" />
            </Style>
            <!-- SP-0034 decision 2: media transport glyphs are direction-independent by convention and
                 must not mirror with the layout. Left to inherit, WPF would flip this triangle to point
                 left under Arabic and Urdu, which reads as "rewind". Stop is a square and is pinned for
                 the same reason only so the pair cannot drift apart later. -->
            <Style x:Key="PlayGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.play}" />
            </Style>
            <Style x:Key="MoreGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.nav.more}" />
            </Style>
            <Style x:Key="StopGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.stop}" />
            </Style>

            <!-- SP-0080: the compact panel's row has room for glyphs and nothing else, so the transport
                 pair gets caption-free variants. The shapes and the FlowDirection pin are the ones
                 above, restated here rather than shared, because a style cannot swap only its template
                 without also re-declaring the geometry its base resolved. -->
            <Style x:Key="PlayGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.play}" />
            </Style>
            <Style x:Key="StopGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.stop}" />
            </Style>
            <Style x:Key="RecordGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.media.record}" />
            </Style>
            <Style x:Key="StopRecordGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.stop}" />
            </Style>
            <!-- SP-0102: Compact panel previous/next station navigation glyph buttons, pinned to LeftToRight -->
            <Style x:Key="PrevGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.previous}" />
            </Style>
            <Style x:Key="NextGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.next}" />
            </Style>
            <!-- SP-0113: media.random - the die, not the shuffle arrows (a shuffle reorders a list; this
                 draws one station). -->
            <Style x:Key="RandomGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.random}" />
            </Style>
            <!-- SP-0113: the compact panel is media.picture-in-picture ("keep playing in a small floating
                 window"); the way back is pending in the vocabulary. The four corners these two drew are
                 media.fullscreen and media.exit-fullscreen, which the player already shows. -->
            <Style x:Key="PictureInPictureGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.media.picture-in-picture}" />
            </Style>
            <Style x:Key="FullWindowGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.media.exit-picture-in-picture}" />
            </Style>
            <!-- The compact panel has no system caption, so it carries its own window buttons
                 (SP-0182: always-on-top is an entry of its overflow menu, not a button). -->
            <Style x:Key="MinimizeGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.window.minimize}" />
            </Style>
            <Style x:Key="CloseGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.nav.close}" />
            </Style>
            <Style x:Key="SaveGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.save}" />
            </Style>
            <Style x:Key="CancelGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.cancel}" />
            </Style>
            <Style x:Key="DownloadGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.download}" />
            </Style>
            <Style x:Key="ResetGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.action.reset}" />
            </Style>
            <Style x:Key="ChooseFolderGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="local:Glyph.Geometry" Value="{StaticResource Icon.pending.action.choose-folder}" />
            </Style>




            <Style TargetType="ComboBox">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ThemedFocusVisual}" />
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="18" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                    <!-- SP-0113: nav.dropdown, the small solid triangle - a chevron here would be nav.expand. -->
                                                    <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                             Margin="0,0,1,0" FlowDirection="LeftToRight">
                                                        <Path Data="{StaticResource Icon.nav.dropdown}" Width="24" Height="24" Fill="{DynamicResource TextBrush}" />
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                    <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}" MaxHeight="320"
                                            Background="{DynamicResource ControlBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                            Padding="3" Margin="0,2,0,4">
                                        <ScrollViewer MaxHeight="310" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
