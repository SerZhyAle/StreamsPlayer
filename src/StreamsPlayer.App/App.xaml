<Application x:Class="StreamsPlayer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Localization.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WindowBackground" Color="#FFF5F7FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
            <SolidColorBrush x:Key="TextBrush" Color="#FF172236" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF2364AA" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="White" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FF637083" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FFD5DCE6" />
            <SolidColorBrush x:Key="ControlBrush" Color="White" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFEFF6FF" />
            <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFD4E2F2" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="CardSelectedBrush" Color="#FFE8F1FA" />
            <SolidColorBrush x:Key="SectionBrush" Color="#FFEEF2F7" />
            <SolidColorBrush x:Key="FaviconPlateBrush" Color="#FFF0F2F5" />
            <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF8A96A8" />
            <SolidColorBrush x:Key="InfoBrush" Color="#FF386C8D" />
            <SolidColorBrush x:Key="GeoHintBrush" Color="#22B36B00" />
            <SolidColorBrush x:Key="GeoTextBrush" Color="#FF8A5300" />
            <SolidColorBrush x:Key="LinkBrush" Color="#FF0067C0" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style TargetType="Control">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <!-- The Foreground setter is not decoration. Every glyph template below paints its Path from
                 the button's own Foreground, and without a setter that property is only inherited - from
                 a Window that has none, so it resolves to the system's black. In the dark theme that put
                 black glyphs on a near-black ControlBrush. The implicit Control style above does not
                 cover this: an implicit style matches the exact type, never a derived one. -->
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <!-- A Grid, not a horizontal StackPanel: a stack measures its children with
                             infinite width, so a wrapping label never learns how much room it has and
                             is clipped instead of wrapped. The star column hands the label the width
                             that is actually left. -->
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBorder" Width="15" Height="15" Margin="0,0,6,0"
                                        VerticalAlignment="Center" Background="{DynamicResource ControlBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2">
                                    <Path x:Name="CheckMark" Data="M3,8 L6,11 L12,4" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Padding" Value="7,4" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="CheckMark" Data="M2,8 L6,12 L14,3" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed" />
                                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                          VerticalAlignment="Center" />
                                        <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M3,2 L8,7 L3,12" Stroke="{DynamicResource MutedBrush}"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Right" AllowsTransparency="True" PopupAnimation="Fade"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}">
                                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" Padding="2">
                                        <StackPanel IsItemsHost="True" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- SP-0050: the catalog refresh keeps the accent it had as a header button now that it lives
                 in the operations menu. A style, not local values on the item: a local Background would
                 outrank the base style's hover trigger. The template's own trigger repaints the row with
                 ControlHoverBrush on hover, so the foreground has to come back off white there or the
                 highlighted entry would be white on near-white. -->
            <Style x:Key="AccentMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,3,0" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Style>
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            </Style>
            <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource GlyphGeometry}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <ContentPresenter Content="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Data="{DynamicResource GlyphGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The caption of a button whose Foreground is chosen for the surface it sits on - a dark
                 status bar, live video - rather than inherited from the theme. A string handed to a
                 ContentPresenter is drawn by a TextBlock the presenter generates, and the implicit
                 TextBlock style above beats the Foreground that TextBlock would otherwise inherit from
                 the button: the caption came out in the theme's text colour however the button was
                 painted. Binding the colour as a local value is what wins that contest. -->
            <DataTemplate x:Key="ButtonOwnColourCaption">
                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </DataTemplate>
            <!-- The player's buttons are drawn over live video, so nothing about their legibility may
                 depend on the frame behind them or on the interface theme. Three things follow, and each
                 is here because leaving it out was visibly wrong:
                 * The fill is opaque. A translucent wash reads over a dark frame and disappears over a
                   bright one, and the player has no say in which frame it gets.
                 * Every caption and glyph carries its colour as a local value - see
                   ButtonOwnColourCaption above for why inheriting it is not enough.
                 * Hover and pressed are restated. Inherited from the interface's Button style they are
                   near-white brushes, and white text vanishes into them.
                 This style is the one home for all three; the glyph variants below add only a shape. -->
            <Style x:Key="PlayerOverlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#FF141A24" />
                <Setter Property="BorderBrush" Value="#FF7E8B9E" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ContentTemplate" Value="{StaticResource ButtonOwnColourCaption}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF27303D" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF39445A" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PlayerOverlayGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource GlyphGeometry}"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PlayerOverlayVolumeGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,10H8L13,6V18L8,14H4ZM16,9A4,4 0 0 1 16,15M18,7A7,7 0 0 1 18,17" /></Style.Resources>
            </Style>
            <!-- SP-0038: the camera carries the whole meaning, so this one overlay button drops its
                 caption; its tooltip still names the action, as every player button does. -->
            <Style x:Key="PlayerOverlayGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                <Path Data="{DynamicResource GlyphGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PlayerOverlayCameraGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphOnlyButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M3,7H7L9,5H15L17,7H21V19H3ZM12,10A3,3 0 1 0 12,16A3,3 0 1 0 12,10" /></Style.Resources>
            </Style>
            <Style x:Key="PlayerOverlayFullscreenGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,10V4H10M14,4H20V10M20,14V20H14M10,20H4V14" /></Style.Resources>
            </Style>
            <Style x:Key="PlayerOverlayCloseGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,5L19,19M19,5L5,19" /></Style.Resources>
            </Style>
            <Style x:Key="PlayerOverlayPinGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M8,4H16V10L19,13V15H5V13L8,10ZM12,15V21" /></Style.Resources>
            </Style>
            <Style x:Key="PlayerOverlayActionsGlyphButton" TargetType="Button" BasedOn="{StaticResource PlayerOverlayGlyphOnlyButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,10A2,2 0 1 0 5,14A2,2 0 1 0 5,10M10,10A2,2 0 1 0 10,14A2,2 0 1 0 10,10M15,10A2,2 0 1 0 15,14A2,2 0 1 0 15,10" /></Style.Resources>
            </Style>
            <!-- SP-0045: the player's signal-health stripe. The stock ProgressBar template is replaced
                 rather than recoloured for two reasons: its animated glow repaints continuously over a
                 native video surface for no informational gain, and its track is not reliably driven by
                 Background - which this indicator needs, because the track is what carries the colour
                 when the buffer is empty and the fill has no width to carry it (decision 3). Both
                 brushes are assigned per state from code; the values here are only the neutral start. -->
            <Style x:Key="SignalHealthStripe" TargetType="ProgressBar">
                <Setter Property="Background" Value="#FF3A414D" />
                <Setter Property="Foreground" Value="#FF8A94A6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" SnapsToDevicePixels="True">
                                <Grid ClipToBounds="True">
                                    <!-- PART_Track is required by ProgressBar's own layout code even though it
                                         draws nothing here; the track colour is the Border above. -->
                                    <Rectangle x:Name="PART_Track" />
                                    <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                               Fill="{TemplateBinding Foreground}" RadiusX="2" RadiusY="2" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ListGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,5H20M4,12H20M4,19H20" /></Style.Resources>
            </Style>
            <Style x:Key="GridGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,4H10V10H4ZM14,4H20V10H14ZM4,14H10V20H4ZM14,14H20V20H14Z" /></Style.Resources>
            </Style>
            <Style x:Key="RefreshGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M19,8V3L22,6M19,3H14M5,16V21L2,18M5,21H10M19,8C17,4 12,3 8,5M5,16C7,20 12,21 16,19" /></Style.Resources>
            </Style>
            <Style x:Key="AddGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M12,4V20M4,12H20" /></Style.Resources>
            </Style>
            <Style x:Key="ImportGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M12,3V13M8,9L12,13L16,9M4,17H20V21H4Z" /></Style.Resources>
            </Style>
            <Style x:Key="ExportGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M12,13V3M8,7L12,3L16,7M4,17H20V21H4Z" /></Style.Resources>
            </Style>
            <Style x:Key="TrashGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,6H20M10,4H14M6,6L7,20H17L18,6M10,10V17M14,10V17" /></Style.Resources>
            </Style>
            <!-- SP-0022: outline clock with a crescent, distinct from the History clock. -->
            <Style x:Key="SleepTimerGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <!-- SP-0022: the clock alone names the control - the caption beside it is the
                                 running countdown and nothing else, so it is absent (and takes no width)
                                 whenever no timer is set. The colour is bound rather than inherited
                                 because this button sits on the dark status bar: the implicit TextBlock
                                 style would otherwise repaint the countdown in the theme's text colour,
                                 which is the bar's own near-black. -->
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                                    <Path Data="M12,3.5 A8.5,8.5 0 1 1 11.99,3.5 M12,7 V12 L15.5,14"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="7,0,0,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M9,3H15L16,6L19,5L22,10L20,12L22,14L19,19L16,18L15,21H9L8,18L5,19L2,14L4,12L2,10L5,5L8,6ZM12,9A3,3 0 1 0 12,15A3,3 0 1 0 12,9" /></Style.Resources>
            </Style>
            <Style x:Key="HiddenGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M3,12C5,8 8,6 12,6C16,6 19,8 21,12C19,16 16,18 12,18C8,18 5,16 3,12M12,9A3,3 0 1 0 12,15A3,3 0 1 0 12,9M4,4L20,20" /></Style.Resources>
            </Style>
            <!-- SP-0019: outline clock (Fill="Transparent") so the hands read against the circle, unlike the filled GlyphButton default. -->
            <Style x:Key="HistoryGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="M12,3.5 A8.5,8.5 0 1 1 11.99,3.5 M12,7.5 V12 L15,14"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Viewbox>
                                <ContentPresenter Content="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LinkGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M10,14L14,10M8,16H6A4,4 0 0 1 6,8H10M16,8H18A4,4 0 0 1 18,16H14" /></Style.Resources>
            </Style>
            <Style x:Key="ClearGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,5L19,19M19,5L5,19" /></Style.Resources>
            </Style>
            <Style x:Key="ClearFiltersGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,5L19,19M19,5L5,19" /></Style.Resources>
            </Style>
            <!-- SP-0050: the operations menu carries a word next to its glyph, so the three dots stay a
                 hint rather than the only thing distinguishing it from the gear beside it. -->
            <Style x:Key="OperationsGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M6,10A2,2 0 1 0 6,14A2,2 0 1 0 6,10M12,10A2,2 0 1 0 12,14A2,2 0 1 0 12,10M18,10A2,2 0 1 0 18,14A2,2 0 1 0 18,10" /></Style.Resources>
            </Style>
            <Style x:Key="FilterGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,5H20L14,12V19L10,21V12Z" /></Style.Resources>
            </Style>
            <!-- SP-0034 decision 2: media transport glyphs are direction-independent by convention and
                 must not mirror with the layout. Left to inherit, WPF would flip this triangle to point
                 left under Arabic and Urdu, which reads as "rewind". Stop is a square and is pinned for
                 the same reason only so the pair cannot drift apart later. -->
            <Style x:Key="PlayGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M7,4L20,12L7,20Z" /></Style.Resources>
            </Style>
            <Style x:Key="MoreGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,12H6M11,12H12M17,12H18" /></Style.Resources>
            </Style>
            <Style x:Key="StopGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M6,6H18V18H6Z" /></Style.Resources>
            </Style>
            <!-- SP-0080: the compact panel's row has room for glyphs and nothing else, so the transport
                 pair gets caption-free variants. The shapes and the FlowDirection pin are the ones
                 above, restated here rather than shared, because a style cannot swap only its template
                 without also re-declaring the geometry its base resolved. -->
            <Style x:Key="PlayGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M7,4L20,12L7,20Z" /></Style.Resources>
            </Style>
            <Style x:Key="StopGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M6,6H18V18H6Z" /></Style.Resources>
            </Style>
            <!-- Two crossing arrows: the shuffle mark, and direction-independent for the same reason the
                 transport glyphs are - it says "any of them", not "forward". -->
            <Style x:Key="RandomGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M3,7H7L17,17H21M17,7H21L11,17H3M18,4L21,7L18,10M18,14L21,17L18,20" /></Style.Resources>
            </Style>
            <!-- Arrows pointing inward: shrink to the panel. Its opposite points outward. Both are pinned
                 to LeftToRight so the pair keeps meaning "in" and "out" rather than mirroring into each
                 other under Arabic and Urdu. -->
            <Style x:Key="CollapseGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M10,4V10H4M20,10H14V4M14,20V14H20M4,14H10V20" /></Style.Resources>
            </Style>
            <Style x:Key="ExpandGlyphOnlyButton" TargetType="Button" BasedOn="{StaticResource GlyphOnlyButton}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,10V4H10M14,4H20V10M20,14V20H14M10,20H4V14" /></Style.Resources>
            </Style>
            <Style x:Key="ConfirmGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,12L9,17L20,6" /></Style.Resources>
            </Style>
            <Style x:Key="CancelGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,5L19,19M19,5L5,19" /></Style.Resources>
            </Style>
            <Style x:Key="FullscreenGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,10V4H10M14,4H20V10M20,14V20H14M10,20H4V14" /></Style.Resources>
            </Style>
            <Style x:Key="VolumeGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,10H8L13,6V18L8,14H4ZM16,9A4,4 0 0 1 16,15M18,7A7,7 0 0 1 18,17" /></Style.Resources>
            </Style>
            <Style x:Key="CloseGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M5,5L19,19M19,5L5,19" /></Style.Resources>
            </Style>
            <Style x:Key="ShortcutGlyphButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
                <Style.Resources><PathGeometry x:Key="GlyphGeometry" Figures="M4,5H14V11M10,9L14,5M14,5L10,1M4,12H12V19H4ZM16,15H20M18,13L20,15L18,17" /></Style.Resources>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                              Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                    <Path Grid.Column="1" Data="M2,5 L8,11 L14,5" Stroke="{DynamicResource TextBrush}"
                                                          StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                    <Border MinWidth="{Binding ActualWidth, ElementName=ToggleButton}" Background="{DynamicResource ControlBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
