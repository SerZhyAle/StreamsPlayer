<Window x:Class="StreamsPlayer.App.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource ImportPreviewTitle}" SizeToContent="Height" MinHeight="300" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SourceText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource ImportCountNew}" Margin="0,3" />
            <TextBlock x:Name="NewCountText" Grid.Column="1" Margin="0,3" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{DynamicResource ImportCountDuplicate}" Margin="0,3" />
            <TextBlock x:Name="DuplicateCountText" Grid.Row="1" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Row="2" Text="{DynamicResource ImportCountInvalid}" Margin="0,3" />
            <TextBlock x:Name="InvalidCountText" Grid.Row="2" Grid.Column="1" Margin="0,3" />
            <TextBlock Grid.Row="3" Text="{DynamicResource ImportCountSkipped}" Margin="0,3" />
            <TextBlock x:Name="SkippedCountText" Grid.Row="3" Grid.Column="1" Margin="0,3" />
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TruncatedText" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
            <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
        <!-- SP-0218: Apply keeps its accent fill (WINDOWS-UI 0.4 section 11 item 7) and takes the check in
             the accent's ink; Cancel is the dismissing answer in the danger hue. -->
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Style="{StaticResource ConfirmGlyphButton}" Content="{DynamicResource ImportApply}" Click="Apply_Click"
                    IsDefault="True" Padding="14,6" Margin="4,3"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
            <Button Style="{StaticResource CancelAnswerGlyphButton}" Content="{DynamicResource Cancel}" IsCancel="True" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
