<Window x:Class="StreamsPlayer.App.ChannelInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource AboutChannelTitle}"
        Height="600" Width="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <DataTemplate x:Key="FactRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{DynamicResource AboutGroupChannel}" Style="{StaticResource GroupHeader}" Margin="0,0,0,6" />
                <ItemsControl x:Name="ChannelFacts" ItemTemplate="{StaticResource FactRowTemplate}" />
                <TextBlock Text="{DynamicResource AboutGroupCatalog}" Style="{StaticResource GroupHeader}" />
                <ItemsControl x:Name="CatalogFacts" ItemTemplate="{StaticResource FactRowTemplate}" />
                <TextBlock Text="{DynamicResource AboutGroupStream}" Style="{StaticResource GroupHeader}" />
                <ItemsControl x:Name="StreamFacts" ItemTemplate="{StaticResource FactRowTemplate}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CopyAllButton" Content="{DynamicResource AboutCopyAll}" Click="CopyAll_Click" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Close}" IsCancel="True" IsDefault="True" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
