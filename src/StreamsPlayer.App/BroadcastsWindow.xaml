<Window x:Class="StreamsPlayer.App.BroadcastsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:StreamsPlayer.App"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource BroadcastsTitle}" Height="520" Width="600"
        MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate DataType="{x:Type app:BroadcastSectionHeading}">
            <StackPanel Margin="0,16,0,4">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Note}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding NoteVisibility}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:BroadcastSectionNote}">
            <TextBlock Text="{Binding Text}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:BroadcastDeviceHeading}">
            <StackPanel Margin="0,14,0,2" Orientation="Horizontal">
                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PresenceText}" Opacity="0.65" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:BroadcastLinkRow}">
            <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StateText}" Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:BroadcastRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Visibility="{Binding ActionsVisibility}" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Style="{StaticResource PlayGlyphButton}" Content="{DynamicResource BroadcastsPlay}" Tag="{Binding}" Click="Play_Click"
                            AutomationProperties.Name="{Binding PlayName}" Margin="0,0,8,0" Padding="12,5" />
                    <Button Style="{StaticResource AddGlyphButton}" Content="{DynamicResource BroadcastsKeep}" Tag="{Binding}" Click="Keep_Click"
                            Visibility="{Binding KeepVisibility}" AutomationProperties.Name="{Binding KeepName}" Padding="12,5" Margin="0" />
                </WrapPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <!-- SP-0234, EXCHANGE-MARK rule 8c: the status of the account's directory leads with the mark, and only
                 while the line is shown (it is hidden once the account's broadcasts are listed). -->
            <DockPanel>
                <app:ExchangeMarkIcon DipSize="16" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,6,0">
                    <app:ExchangeMarkIcon.Style>
                        <Style TargetType="app:ExchangeMarkIcon">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=StatusText}" Value="Collapsed">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </app:ExchangeMarkIcon.Style>
                </app:ExchangeMarkIcon>
                <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="SettingsButton" Style="{StaticResource SettingsGlyphButton}" Content="{DynamicResource BroadcastsOpenSettings}"
                        Click="OpenSettings_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                <Button x:Name="DiagnoseButton" Style="{StaticResource SettingsGlyphButton}" Content="{DynamicResource ExchangeDiagnose}"
                        Click="Diagnose_Click" Visibility="Collapsed" />
            </WrapPanel>
        </StackPanel>
        <ListBox x:Name="BroadcastList" Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="0,6,0,0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{DynamicResource BroadcastsTitle}" KeyDown="BroadcastList_KeyDown" />
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
            <Label Content="{DynamicResource BroadcastsOpenByLink}" Target="{Binding ElementName=LinkBox}" Padding="0,0,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LinkBox" Padding="6,4" VerticalContentAlignment="Center" KeyDown="LinkBox_KeyDown"
                         AutomationProperties.Name="{DynamicResource BroadcastsOpenByLink}" />
                <Button x:Name="LinkOpenButton" Grid.Column="1" Style="{StaticResource PlayGlyphButton}" Content="{DynamicResource BroadcastsLinkOpen}"
                        Click="OpenLink_Click" Margin="8,0,0,0" Padding="12,5" />
            </Grid>
        </StackPanel>
        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SettingsLinkButton}" Content="{DynamicResource MediaExchange}" Click="ExchangeHelp_Click"
                    ToolTip="{DynamicResource MediaExchangeTip}" AutomationProperties.Name="{DynamicResource MediaExchange}" Margin="4,3" />
            <Button Style="{StaticResource CloseAnswerGlyphButton}" Content="{DynamicResource Close}" Click="Close_Click" Margin="4,3" />
        </WrapPanel>
    </Grid>
</Window>
