<Window x:Class="StreamsPlayer.App.BroadcastsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:StreamsPlayer.App"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource BroadcastsTitle}" Height="480" Width="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type app:BroadcastDeviceHeading}">
            <StackPanel Margin="0,14,0,2" Orientation="Horizontal">
                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PresenceText}" Opacity="0.65" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type app:BroadcastRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding ActionsVisibility}"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="{DynamicResource BroadcastsPlay}" Tag="{Binding}" Click="Play_Click"
                            Margin="0,0,8,0" Padding="12,5" />
                    <Button Content="{DynamicResource BroadcastsKeep}" Tag="{Binding}" Click="Keep_Click" Padding="12,5" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock x:Name="EmptyText" Text="{DynamicResource BroadcastsEmpty}" Grid.Row="1" Visibility="Collapsed"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" />
        <ListBox x:Name="BroadcastList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Close}" IsCancel="True" Padding="14,6" />
        </StackPanel>
    </Grid>
</Window>
