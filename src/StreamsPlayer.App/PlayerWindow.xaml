<Window x:Class="StreamsPlayer.App.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="{DynamicResource UiFlowDirection}" Title="{DynamicResource PlayerWindowTitle}" Height="720" Width="1120" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="Black" KeyDown="Window_KeyDown">
    <!-- Out of theme (APP-STYLE 5, a content-coloured window): the player shows video, and black behind
         video is the product, not a missing theme. Everything drawn over the picture - the control
         panel, the recording badge, the interruption notice, the frame toast - carries its own dark
         backing and its own light ink, so it reads over any frame in either theme. The chrome stays
         themed: every menu, dialog and tooltip this window opens takes the application's styles. -->
    <Grid>
        <!-- SP-0026: the selected video backend's surface is injected here at runtime. -->
        <Grid x:Name="VideoHost" />
        <!-- ControlsOverlay is detached at runtime and hosted inside the backend's native video
             surface so it floats above the video (airspace) instead of being covered on resize.
             SP-0072: that reparenting also takes it out of this window's inheritance chain, so the
             window's FlowDirection no longer reaches it - hence the explicit binding here. Without it
             the overlay renders left-to-right in Arabic and Urdu whatever the window declares. -->
        <Grid x:Name="ControlsOverlay" Background="#01000000" PreviewMouseDown="VideoSurface_MouseDown"
              FlowDirection="{DynamicResource UiFlowDirection}">
        <Border x:Name="ControlPanel" VerticalAlignment="Bottom" Background="#B0000000" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Left group: Playback audio/volume controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="MuteButton" Style="{StaticResource PlayerOverlayMuteGlyphButton}" Content="{DynamicResource Mute}" Click="MuteButton_Click"
                            ToolTip="{DynamicResource MuteTip}" />
                    <!-- IsMoveToPointEnabled: a click jumps the volume straight to the clicked level instead of stepping toward it. -->
                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="100" TickFrequency="10"
                            IsMoveToPointEnabled="True" FocusVisualStyle="{StaticResource PlayerOverlayFocusVisual}"
                            ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center" Margin="4,0,8,0"
                            ToolTip="{DynamicResource VolumeTip}" AutomationProperties.Name="{DynamicResource VolumeName}" />
                </StackPanel>

                <!-- Center group: Title, OnAir text, buffering status and signal health stripe -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" FontSize="15"
                               TextTrimming="CharacterEllipsis" MaxWidth="480" />
                    <!-- SP-0073: what is on air, under the name of the channel it is on. Collapsed until
                         the stream announces something, so a source that says nothing leaves this panel
                         exactly as it was. TextTrimming is what bounds a hostile or padded title to one
                         line - the column beside it is Auto, so untrimmed text would push the buttons. -->
                    <TextBlock x:Name="OnAirText" Foreground="#FFD4DCE8" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                    <!-- SP-0075: now and next from the user's TV schedule. Collapsed without one, so a channel
                         with no schedule leaves this panel as it was; trimmed for the same reason as above. -->
                    <TextBlock x:Name="ScheduleNowText" Foreground="#FFD4DCE8" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="ScheduleNextText" Foreground="#FFA9B4C4" FontSize="11" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="WaitText" Text="{DynamicResource Buffering}" Foreground="#FFD4DCE8" FontSize="11" Margin="0,2,0,0" />
                    <!-- SP-0045: still the buffer gauge (0..100); its colour now reports signal health,
                         and both brushes plus the tooltip are assigned from code so the colour and the
                         word can never disagree. -->
                    <ProgressBar x:Name="BufferProgress" Height="4" Width="180" Maximum="100" Margin="0,3,0,0"
                                 HorizontalAlignment="Left" Style="{StaticResource SignalHealthStripe}"
                                 AutomationProperties.Name="{DynamicResource SignalHealthName}" />
                </StackPanel>

                <!-- Right group: Media tracks, capture, record, fullscreen, actions and close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AudioTracksButton" Content="{DynamicResource AudioTracks}" Click="AudioTracksButton_Click"
                            Visibility="Hidden" ToolTip="{DynamicResource AudioTracksTip}" Style="{StaticResource PlayerOverlayButton}" />
                    <Button x:Name="SubtitleTracksButton" Content="{DynamicResource SubtitleTracks}" Click="SubtitleTracksButton_Click"
                            Visibility="Hidden" ToolTip="{DynamicResource SubtitleTracksTip}" Style="{StaticResource PlayerOverlayButton}" />
                    <Button x:Name="SaveFrameButton" Style="{StaticResource PlayerOverlaySaveFrameGlyphButton}"
                            Click="SaveFrameButton_Click" ToolTip="{DynamicResource SaveFrameTip}"
                            AutomationProperties.Name="{DynamicResource SaveFrame}" />
                    <Button x:Name="RecordButton" Style="{StaticResource PlayerOverlayRecordGlyphButton}"
                            Click="RecordButton_Click" ToolTip="{DynamicResource RecordTip}"
                            AutomationProperties.Name="{DynamicResource Record}" />
                    <!-- SP-0191: pin the control panel so it stays over the video (WINDOWS-UI 8.4). The glyph
                         shows the toggle's state: the declared off form when not pinned, action.pin when
                         pinned. The accessible name is the toggle's one meaning either way. -->
                    <Button x:Name="PinControlsButton" Style="{StaticResource PlayerOverlayControlsUnpinnedGlyphButton}"
                            Click="PinControlsButton_Click" ToolTip="{DynamicResource PlayerPinControlsName}"
                            AutomationProperties.Name="{DynamicResource PlayerPinControlsName}" />
                    <Button x:Name="FullscreenButton" Style="{StaticResource PlayerOverlayFullscreenGlyphButton}" Content="{DynamicResource Fullscreen}" Click="FullscreenButton_Click"
                            ToolTip="{DynamicResource FullscreenTip}" />
                    <Button x:Name="ActionsButton" Style="{StaticResource PlayerOverlayActionsGlyphButton}" Click="ActionsButton_Click"
                            ToolTip="{DynamicResource PlayerActionsTip}" AutomationProperties.Name="{DynamicResource PlayerActionsName}" />
                    <Button Style="{StaticResource PlayerOverlayCloseGlyphButton}" Content="{DynamicResource Close}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- SP-0102: Floating top recording badge with pulsing red dot, stays visible during recording regardless of auto-hide -->
        <Border x:Name="RecordIndicator" VerticalAlignment="Top" HorizontalAlignment="Right"
                Background="#D0000000" CornerRadius="4" Padding="10,6" Margin="16"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#FFFF4D4D" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RecordTimerText" Foreground="#FFFF4D4D" FontWeight="SemiBold" FontSize="13" Text="REC 00:00" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <!-- SP-0072: why the screen is black, said in the layer that survives the control panel's
             auto-hide. HorizontalAlignment is Left rather than a corner name so the overlay's
             FlowDirection mirrors it into the trailing corner for right-to-left languages. -->
        <Border x:Name="InterruptionNotice" VerticalAlignment="Top" HorizontalAlignment="Left"
                Background="#B0000000" CornerRadius="4" Padding="10,6" Margin="12"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="InterruptionNoticeText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                MaxWidth="360" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="FrameSavedToast" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#C8000000" CornerRadius="6" Padding="20,13" Opacity="0" IsHitTestVisible="False">
            <!-- SP-0038: the text now names the file written (or the failure), so it is assigned in code
                 instead of following a DynamicResource. -->
            <TextBlock x:Name="FrameToastText" Foreground="White" FontSize="18" FontWeight="SemiBold"
                       MaxWidth="720" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
        </Grid>
    </Grid>
</Window>
