<?xml version="1.0" encoding="utf-8"?>
<!-- Template. build-msix.ps1 writes a filled copy into its ignored stage directory. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 rescap">
  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Streams Player</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Internet radio, live video and RTSP player for Windows.</Description>
  </Properties>
  <Resources>__LANGUAGE_RESOURCES__</Resources>
  <Dependencies><TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" /></Dependencies>
  <Applications>
    <Application Id="StreamsPlayer" Executable="StreamsPlayer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Streams Player" Description="Browse and play internet radio, live video and RTSP streams." BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <!-- SP-0127: the stable start route desktop shortcuts use; the install folder changes on every update. -->
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="StreamsPlayer.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="StreamsPlayer.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- 196 section 6.2: the primary import path of a broadcast resource - double-click the
             document Fast Media Sorter saved. The launch argument is the file's path; the app's
             StreamLaunchRequest answers it as a File target. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="spres" DesiredView="same" AllowOn="desktop">
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/json">.spres</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <!-- SP-0229: the camera is used for one thing - reading a connection QR after the person presses "Scan with the camera".
       Declared so Windows lists the app in its camera privacy settings from install, even for a full-trust package;
       the privacy statement, the Store text and the READMEs say the same (PrivacyStatementTests holds them together). -->
  <Capabilities><rescap:Capability Name="runFullTrust" /><DeviceCapability Name="webcam" /></Capabilities>
</Package>
