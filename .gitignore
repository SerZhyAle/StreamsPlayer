# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
.vs/
artifacts/
dist/
stage/
msix/stage/
msix/dist/
*.msix
*.appx
*.cer
*.pfx
*.sha256

# Visual Studio and local settings
*.user
*.suo
*.userprefs
*.rsuser

# Local diagnostics and secrets
temp/
tmp/
PLAN/
*.log
appsettings.Development.json
secrets/

# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.snk
*.jks
*.keystore
.env
*token*
*secret*

# Bundled catalog snapshot - tracked on purpose (SP-0052, SP-0060). tools/build-catalog-snapshot.ps1
# produces it; StreamsPlayer.Core embeds it as a resource, so a clone without it builds an app with an
# empty catalog. Regenerate it with the script, never hand-edit it.
!src/StreamsPlayer.Core/Resources/catalog-snapshot.zip

# SecretClipboard.cs is source code (the helper that keeps a copied password out of the clipboard history); the
# *secret* rule above would silently keep it out of git and break a clean checkout (found by CI on 26.1025.1927).
!src/StreamsPlayer.App/SecretClipboard.cs

# Editor-local settings - personal colour schemes and layouts, never product state.
.vscode/
.idea/

# Generated spec-command wrappers (SP-0257). The sza plugin's register-spec-commands.ps1 writes these eight
# forwarders into .claude/commands on each machine (forwards_to marker). They are per-install output, not product
# documents: a registry entry for a file a clean checkout lacks fails the documentation gate, and build-local's
# `git add --all` would otherwise commit them.
/.claude/commands/sa.md
/.claude/commands/sd.md
/.claude/commands/sn.md
/.claude/commands/sq.md
/.claude/commands/spec-all.md
/.claude/commands/spec-draft.md
/.claude/commands/spec-next.md
/.claude/commands/spec-quiz.md
