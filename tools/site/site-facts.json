{
  "$comment": "SP-0198 (SITE-REPRESENTATION rules 1 to 3). The facts the site copy states, each with the file a program reads it from, and the surfaces that must list the pillars of POSITIONING.md in its order. tools/site/SiteFacts.ps1 renders the language count and the minimum Windows into the copy decks and checks the rest, including (SP-0247) the language count typed in the README, Store listing and winget prose; build-site.ps1 -Check runs it. A pattern's first capture group is the value.",

  "positioning": {
    "source": "POSITIONING.md",
    "surfaces": [
      { "path": "README.md", "locale": "en" },
      { "path": "README.ru.md", "locale": "ru" },
      { "path": "README.uk.md", "locale": "uk" },
      { "path": "msix/listing/en-us.txt", "locale": "en" },
      { "path": "msix/listing/ru.txt", "locale": "ru" },
      { "path": "msix/listing/uk.txt", "locale": "uk" }
    ],
    "deckLead": { "key": "what-p1", "locales": ["en", "ru", "uk"] },
    "deckKeyLine": { "key": "hero-kicker", "separator": "·" }
  },

  "minimumWindows": {
    "source": { "path": "src/StreamsPlayer.App/StreamsPlayer.App.csproj", "pattern": "<SupportedOSPlatformVersion>([^<]+)</SupportedOSPlatformVersion>" },
    "agree": [
      { "path": "msix/AppxManifest.xml", "pattern": "TargetDeviceFamily[^>]*MinVersion=\"([^\"]+)\"" },
      { "path": "winget/templates/SerZhyAle.StreamsPlayer.installer.yaml", "pattern": "(?m)^MinimumOSVersion:\\s*(\\S+)" }
    ]
  },

  "channels": [
    { "id": "setup", "deckKey": "channel-setup", "evidence": [
      { "path": "installer/StreamsPlayer.iss" },
      { "path": ".github/workflows/release.yml", "contains": "-windows-x64-setup.exe" } ] },
    { "id": "portable-zip", "deckKey": "channel-github", "evidence": [
      { "path": ".github/workflows/release.yml", "contains": "-windows-x64.zip" } ] },
    { "id": "store", "deckKey": "channel-store", "name": "Microsoft Store", "evidence": [
      { "path": "msix/AppxManifest.xml" } ] },
    { "id": "winget", "deckKey": "channel-winget", "name": "winget", "orMarker": "[[command]]", "evidence": [
      { "path": "winget/templates/SerZhyAle.StreamsPlayer.installer.yaml" } ] }
  ],

  "channelProse": ["status-description", "use-description", "distribution-description"],

  "renderedKeys": {
    "languages": ["fact-langs", "cap-yours-4"],
    "windows": ["hero-eyebrow", "fact-windows"]
  },

  "languageCount": {
    "$comment": "SP-0247 (SITE-REPRESENTATION rule 3). Surfaces that are not rendered from a copy deck type the interface language count in their own prose. Each statement is a file, its locale and a pattern whose one capture group is the count; every match must equal the InterfaceLanguages count, as a digit or as a number word listed below for that locale, and a pattern that stops matching fails. A new count needs its words added here and the prose changed; nothing else.",
    "numberWords": {
      "en": { "thirteen": 13 },
      "ru": { "тринадцати": 13, "тринадцатью": 13, "тринадцать": 13 },
      "uk": { "тринадцятьма": 13, "тринадцять": 13 },
      "de": { "dreizehn": 13 },
      "it": { "tredici": 13 },
      "es": { "trece": 13 },
      "fr": { "treize": 13 },
      "pt": { "treze": 13 },
      "zh": { "十三": 13 },
      "hi": { "तेरह": 13 },
      "bn": { "তেরো": 13 },
      "ar": { "ثلاث عشرة": 13 },
      "ur": { "تیرہ": 13 }
    },
    "surfaces": [
      { "path": "README.md", "locale": "en", "pattern": "; (\\S+) languages, endonyms only" },
      { "path": "README.md", "locale": "en", "pattern": "interface between (\\S+) languages" },
      { "path": "README.ru.md", "locale": "ru", "pattern": "; (\\S+) языков, только самоназвания" },
      { "path": "README.ru.md", "locale": "ru", "pattern": "интерфейс между (\\S+) языками" },
      { "path": "README.uk.md", "locale": "uk", "pattern": "; (\\S+) мов, лише самоназви" },
      { "path": "README.uk.md", "locale": "uk", "pattern": "інтерфейс між (\\S+) мовами" },
      { "path": "winget/templates/SerZhyAle.StreamsPlayer.locale.en-US.yaml", "locale": "en", "pattern": "available in (\\S+) languages" },
      { "path": "winget/templates/SerZhyAle.StreamsPlayer.locale.ru-RU.yaml", "locale": "ru", "pattern": "доступен на (\\S+) языках" },
      { "path": "winget/templates/SerZhyAle.StreamsPlayer.locale.uk-UA.yaml", "locale": "uk", "pattern": "доступний (\\S+) мовами" },
      { "path": "msix/listing/en-us.txt", "locale": "en", "pattern": "available in (\\S+) languages" },
      { "path": "msix/listing/en-us.txt", "locale": "en", "pattern": "(?m)^(\\S+) interface languages" },
      { "path": "msix/listing/ru.txt", "locale": "ru", "pattern": "доступен на (\\S+) языках" },
      { "path": "msix/listing/ru.txt", "locale": "ru", "pattern": "(?m)^(\\S+) языков интерфейса" },
      { "path": "msix/listing/uk.txt", "locale": "uk", "pattern": "доступний (\\S+) мовами" },
      { "path": "msix/listing/uk.txt", "locale": "uk", "pattern": "(?m)^(\\S+) мов інтерфейсу" },
      { "path": "msix/listing/de.txt", "locale": "de", "pattern": "gibt es in (\\S+) Sprachen" },
      { "path": "msix/listing/de.txt", "locale": "de", "pattern": "(?m)^(\\S+) Oberflächensprachen" },
      { "path": "msix/listing/it.txt", "locale": "it", "pattern": "disponibile in (\\S+) lingue" },
      { "path": "msix/listing/it.txt", "locale": "it", "pattern": "(?m)^(\\S+) lingue dell'interfaccia" },
