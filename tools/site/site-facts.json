      { "path": "msix/listing/es.txt", "locale": "es", "pattern": "(?m)^(\\S+) idiomas de interfaz" },
      { "path": "msix/listing/fr.txt", "locale": "fr", "pattern": "disponible en (\\S+) langues" },
      { "path": "msix/listing/fr.txt", "locale": "fr", "pattern": "(?m)^(\\S+) langues d'interface" },
      { "path": "msix/listing/pt-br.txt", "locale": "pt", "pattern": "disponível em (\\S+) idiomas" },
      { "path": "msix/listing/pt-br.txt", "locale": "pt", "pattern": "(?m)^(\\S+) idiomas de interface" },
      { "path": "msix/listing/zh-hans.txt", "locale": "zh", "pattern": "完整界面提供(\\S+?)种语言" },
      { "path": "msix/listing/zh-hans.txt", "locale": "zh", "pattern": "(?m)^(\\S+?)种界面语言" },
      { "path": "msix/listing/hi.txt", "locale": "hi", "pattern": "(\\S+) भाषाओं में उपलब्ध" },
      { "path": "msix/listing/hi.txt", "locale": "hi", "pattern": "(?m)^(\\S+) \\S+ भाषाएँ," },
      { "path": "msix/listing/bn.txt", "locale": "bn", "pattern": "(\\S+?)টি ভাষায়" },
