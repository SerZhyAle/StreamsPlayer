      { "path": "msix/listing/ar.txt", "locale": "ar", "pattern": "متاحة ب(.+?) لغة" },
      { "path": "msix/listing/ar.txt", "locale": "ar", "pattern": "(?m)^(.+?) لغة واجهة" },
      { "path": "msix/listing/ur.txt", "locale": "ur", "pattern": "(\\S+) زبانوں میں دستیاب" },
      { "path": "msix/listing/ur.txt", "locale": "ur", "pattern": "(?m)^(\\S+) \\S+ زبانیں،" }
    ]
  }
}
