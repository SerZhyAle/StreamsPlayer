# Normalize text, while retaining CRLF for Windows-oriented source files.
* text=auto

*.cs       text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.ps1      text eol=crlf
*.xml      text eol=crlf
*.yml      text eol=crlf
*.yaml     text eol=crlf
*.md       text eol=crlf
*.html     text eol=crlf
*.css      text eol=crlf
*.txt      text eol=crlf

# SP-0034: the Partner Center listing fixture is compared byte for byte by
# tools/store/build-store-listing-csv.ps1 -FillNothing. Line-ending normalization would break that
# round trip, so git must leave the bytes alone.
msix/store-listing-export.sample.csv -text

*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.msix binary
