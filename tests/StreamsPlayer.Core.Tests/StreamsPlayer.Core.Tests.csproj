<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StreamsPlayer.Core\StreamsPlayer.Core.csproj" />
  </ItemGroup>

  <!-- SP-0099: transport code is compiled here without a WPF project reference so a local HTTP
       listener can prove the one-request contract independently of an audio device. -->
  <ItemGroup>
    <Compile Include="..\..\src\StreamsPlayer.App\FastMediaSorterPlaybackTransport.cs"
             Link="FastMediaSorterPlaybackTransport.cs" />
  </ItemGroup>

  <!-- SP-0164: the radio recorder is WPF-free too, and its contract - an end raised before anyone
       subscribed, a file written nothing into, a folder refusal reported as a write failure - is
       proven against local servers and temp folders. Compiled as sources, on the SP-0099 terms. -->
  <ItemGroup>
    <Compile Include="..\..\src\StreamsPlayer.App\StreamAudioRecorder.cs"
             Link="app-compile\StreamAudioRecorder.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\RecordingWriteProbe.cs"
             Link="app-compile\RecordingWriteProbe.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\RecordingFinisher.cs"
             Link="app-compile\RecordingFinisher.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\RecordingStaging.cs"
             Link="app-compile\RecordingStaging.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\AppPaths.cs"
             Link="app-compile\AppPaths.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\CaptureFolders.cs"
             Link="app-compile\CaptureFolders.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\CurrentLog.cs"
             Link="app-compile\CurrentLog.cs" />
    <Compile Include="..\..\src\StreamsPlayer.App\StreamTitleFormatter.cs"
             Link="app-compile\StreamTitleFormatter.cs" />
  </ItemGroup>

  <!--
    SP-0034 criterion 2: the language parity gate has to run in CI, and CI runs dotnet test. The App's
    resource dictionaries are therefore copied in as test DATA and parsed as XML. This is deliberately
    a file dependency, not a ProjectReference - tests depend on Core only, and a WPF ResourceDictionary
    could not be loaded here anyway. Do not turn this into a project reference.
  -->
  <ItemGroup>
    <Content Include="..\..\src\StreamsPlayer.App\Localization.*.xaml"
             Link="localization\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="localization-loanwords.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The country facet offers a country with a flag or not at all, so the flag folder and the name table
       are checked against each other. Test DATA on the same terms as the dictionaries above: files, never loaded. -->
  <ItemGroup>
    <Content Include="..\..\src\StreamsPlayer.App\Assets\Flags\*.png"
             Link="flags\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    There used to be a third Content item here: a copy of the LIVE-BROADCAST contract document, copied to
    the test output so one test could assert the repository was holding the real thing. Both are gone. The
    contract has one home now - the shared contract store named in CLAUDE.md, pointed at by
    docs/contracts/LIVE-BROADCAST.md - and a build that reads a file from outside the repository cannot
    run on a clone, on CI, or on any machine that does not have that store mounted. What this suite may
    depend on is the wire behaviour, which FastMediaSorterBroadcastDescriptorTests covers on its own.
  -->

  <!--
    SP-0057: the arity gate compares those dictionaries against the code that formats them, so the App's
    own sources come in as test DATA on the same terms - read as text, never loaded, no project reference.
    A non-recursive glob on purpose: the App directory is flat, and ** would sweep in bin and obj, whose
    generated sources are not call sites and whose file names collide.
  -->
  <ItemGroup>
    <Content Include="..\..\src\StreamsPlayer.App\*.cs"
             Link="app-source\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\StreamsPlayer.App\*.xaml"
             Exclude="..\..\src\StreamsPlayer.App\Localization.*.xaml"
             Link="app-source\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SP-0105: the INSTALL-TRUST page is generated from a template and thirteen copy decks. The generator's
    own -Check runs in CI (the "Site sync check" step of ci.yml) but only proves that docs/ matches the
    decks; it does not read what a deck says. The shape the contract demands (InstallTrustPageTests) and
    the names the support page gives the application's controls (SP-0039, SupportPageTests) are therefore
    gated here, with the site sources as test DATA on the same terms as above - read as text, nothing loaded.
  -->
  <ItemGroup>
    <Content Include="..\..\tools\site\copy\*.txt"
             Link="site-copy\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\site\templates\*.html"
             Link="site-templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SP-0039: the winget locale templates and the Store's forbidden-terms list, read as text, so the same
    list that fails a Store search term also holds a forbidden term out of a winget tag. Test DATA on the
    same terms as above - the files are never loaded, and nothing here references a project.
  -->
  <ItemGroup>
    <Content Include="..\..\winget\templates\*.locale.*.yaml"
             Link="winget-templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\msix\listing\forbidden-terms.txt"
             Link="msix-listing\forbidden-terms.txt"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SP-0039: the author's one contact address is typed in the application (ProductInfo.AuthorEmail, already
    linked above as app source), in the written offer of the third-party notices and in the Store listing's
    support-email field. The site derives its copy from the constant; these two hand-typed holders are read as
    text, on the same terms as above, so a change of address cannot reach one and miss the other.
  -->
  <ItemGroup>
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt"
             Link="notices\THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\msix\store-listing.md"
             Link="msix-listing\store-listing.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SP-0136: the installer script, read as text, so the lock name it checks is held against the one the
    application takes. Inno is not part of the .NET toolchain; this is the check CI can always run.
  -->
  <ItemGroup>
    <Content Include="..\..\installer\StreamsPlayer.iss"
             Link="installer\StreamsPlayer.iss"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SP-0156: the release and Pages workflows, read as text, so the gates that decide what ships - the smoke
    verdict, green CI, the pinned natives, the never-replaced published assets and the site's wait for CI -
    are held in place by the same suite CI always runs. A workflow cannot be unit-tested; its gates can be.
  -->
  <ItemGroup>
    <Content Include="..\..\.github\workflows\release.yml;..\..\.github\workflows\pages.yml"
             Link="workflows\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    SP-0113: the icon map, the vendored ICON-SET glyphs and their provenance, on the same terms - read as
    text. The contract store they were copied from is not part of a clone; tools/Sync-IconGlyphs.ps1 -Check
    compares against it where it is mounted, and these tests hold the copies against each other everywhere.
  -->
  <ItemGroup>
    <Content Include="..\..\src\StreamsPlayer.App\Glyphs.map.json"
             Link="app-source\Glyphs.map.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\glyphs\**\*.svg;..\..\assets\glyphs\PROVENANCE.txt"
             Link="glyphs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
